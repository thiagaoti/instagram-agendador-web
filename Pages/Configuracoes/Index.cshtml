@page
@model InstagramAgendador.Web.Pages.Configuracoes.IndexModel
@{
    ViewData["Title"] = "Admin: Usuários, Perfis IG e Configurações";
}

<style>
    .cfg-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .cfg-eyebrow {
        color: var(--accent);
        font-size: 11px;
        font-weight: 850;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .cfg-title {
        margin: 0;
        font-size: clamp(24px, 3.5vw, 32px);
        font-weight: 900;
    }

    .cfg-desc {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 13px;
        max-width: 820px;
        line-height: 1.6;
    }

    .cfg-alert {
        padding: 13px 16px;
        margin-bottom: 20px;
        border-radius: 10px;
        background: #153224;
        border: 1px solid #285c40;
        color: #9af0b9;
        font-size: 13px;
    }

    .cfg-alert.erro {
        background: #3b1c26;
        border-color: #7b3248;
        color: #ffb4b4;
    }

    .cfg-section {
        padding: 22px;
        margin-bottom: 24px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
    }

    .cfg-section-title {
        margin: 0 0 4px;
        font-size: 18px;
        font-weight: 850;
    }

    .cfg-section-sub {
        margin: 0 0 18px;
        color: var(--muted);
        font-size: 12.5px;
    }

    .cfg-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
        gap: 14px;
        min-width: 0;
    }

    .cfg-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
    }

    .cfg-field label {
        font-size: 11.5px;
        font-weight: 750;
        color: #e2d7f0;
    }

    .cfg-field input,
    .cfg-field select {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 9px 11px;
        background: var(--panel-alt);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font-size: 12.5px;
    }

    .cfg-field small {
        font-size: 10.5px;
        color: var(--muted);
    }

    .cfg-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 38px;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        border: 1px solid transparent;
        text-decoration: none;
    }

    .cfg-btn-primary {
        background: linear-gradient(90deg, #ff4f8b, #ff7a59);
        color: #16050c;
    }

    .cfg-btn-secondary {
        background: #231c35;
        border-color: #3d315b;
        color: #eadff7;
    }

    .cfg-btn-danger {
        background: #381924;
        border-color: #6e2b42;
        color: #ffb4b4;
    }

    .cfg-card-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-top: 18px;
    }

    .cfg-account-card {
        padding: 18px;
        background: var(--panel-alt);
        border: 1px solid var(--border);
        border-radius: 12px;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
    }

    @@media (max-width: 640px) {
        .cfg-section {
            padding: 15px 12px;
        }
        .cfg-account-card {
            padding: 13px 11px;
        }
        .cfg-btn {
            width: 100%;
        }
    }

    .cfg-pill {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 850;
        text-transform: uppercase;
    }

    .cfg-pill.ok {
        background: #153224;
        color: #9af0b9;
        border: 1px solid #285c40;
    }

    .cfg-pill.warn {
        background: #382a14;
        color: #ffd089;
        border: 1px solid #6b4e20;
    }

    .cfg-pill.user {
        background: #231934;
        color: #f3d4ff;
        border: 1px solid #442f66;
    }
</style>

<div class="cfg-header">
    <div>
        <div class="cfg-eyebrow">PAINEL EXCLUSIVO DO ADMINISTRADOR</div>
        <h1 class="cfg-title">Incluir Perfis do Instagram por Usuário & Configurações</h1>
        <p class="cfg-desc">
            Somente você (Administrador) tem acesso a esta tela. Aqui você inclui o(s) perfil(is) do Instagram para cada usuário com a sua respectiva configuração (Account ID, Access Token Meta e horários de postagem).
        </p>
    </div>
    <a href="/" class="cfg-btn cfg-btn-secondary">← Voltar para a Central de Agendamentos</a>
</div>

@if (TempData["Mensagem"] is string msg)
{
    <div class="cfg-alert @(TempData["TipoMensagem"]?.ToString() == "erro" ? "erro" : "")" role="status">
        @msg
    </div>
}

<!-- 0. CONEXÃO EM 1 CLIQUE (ESTILO MLABS) — CONFIGURAR APP META E LINKS PARA CLIENTES -->
<section class="cfg-section" style="background:linear-gradient(160deg,#151c33 0%,#141122 100%);border-color:#2e4a80;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:8px;">
        <span class="cfg-pill ok" style="background:#172554;border-color:#3b82f6;color:#93c5fd;">
            ⚡ MODO MAIS FÁCIL · CONEXÃO EM 1 CLIQUE PELO FACEBOOK (IGUAL MLABS)
        </span>
        @if (!string.IsNullOrWhiteSpace(Model.MetaAppIdSalvo) && Model.MetaAppSecretSalvo)
        {
            <span class="cfg-pill ok">✅ App Meta Configurado e Ativo</span>
        }
        else
        {
            <span class="cfg-pill warn">Preencha o App ID e App Secret abaixo 1 única vez</span>
        }
    </div>

    <h2 class="cfg-section-title">Conexão Automática em 1 Clique (Sem Precisar Pegar Token ou ID)</h2>
    <p class="cfg-section-sub">
        Salve o <strong>ID do Aplicativo</strong> e a <strong>Chave Secreta</strong> do seu App da Meta uma única vez abaixo. Depois disso, basta clicar em <strong>"🔵 Conectar Instagram pelo Facebook"</strong> (ou enviar o link de 1 clique para o seu cliente na seção de usuários lá embaixo) que o sistema pega o Token de 60 dias, o <code>@@arroba</code> e o <code>Account ID</code> sozinho!
    </p>

    <div style="margin-bottom:14px;padding:12px 14px;background:#0e1424;border:1px solid #2b3f6c;border-radius:10px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
        <div style="min-width:0;">
            <div style="font-size:11px;font-weight:800;color:#93c5fd;text-transform:uppercase;">
                URL de Redirecionamento OAuth para colar no seu App da Meta (Login do Facebook ➔ Configurações):
            </div>
            <code id="urlRedirectOAuthText" style="display:block;margin-top:4px;font-size:12.5px;color:#fff;word-break:break-all;">@Model.RedirectUriOAuth</code>
        </div>
        <button type="button"
                class="cfg-btn cfg-btn-secondary"
                onclick="navigator.clipboard.writeText(document.getElementById('urlRedirectOAuthText').textContent); this.textContent='✅ URL Copiada!';">
            📋 Copiar URL
        </button>
    </div>

    <form method="post" asp-page-handler="SalvarCredenciaisMeta">
        @Html.AntiForgeryToken()
        <div class="cfg-grid" style="align-items:end;">
            <div class="cfg-field">
                <label for="cfgMetaAppId">Meta App ID (ID do Aplicativo)</label>
                <input id="cfgMetaAppId"
                       name="metaAppId"
                       type="text"
                       value="@Model.MetaAppIdSalvo"
                       placeholder="Ex.: 123456789012345"
                       required />
            </div>

            <div class="cfg-field">
                <label for="cfgMetaAppSecret">Meta App Secret (Chave Secreta do Aplicativo)</label>
                <input id="cfgMetaAppSecret"
                       name="metaAppSecret"
                       type="password"
                       placeholder="@(Model.MetaAppSecretSalvo ? "•••••••••••• (Já salva no banco — digite p/ trocar)" : "Cole a Chave Secreta do App Meta")" />
            </div>

            <div class="cfg-field">
                <button type="submit" class="cfg-btn cfg-btn-primary">
                    💾 Salvar App Meta
                </button>
            </div>

            <div class="cfg-field">
                <a href="/ConectarInstagram"
                   class="cfg-btn"
                   style="background:#1877f2;color:#fff;font-weight:850;">
                    🔵 Conectar Instagram pelo Facebook (1 Clique)
                </a>
            </div>
        </div>
    </form>
</section>

<!-- 1. INCLUIR PERFIL DO INSTAGRAM PARA CADA USUÁRIO COM SUA RESPECTIVA CONFIGURAÇÃO -->
<section class="cfg-section">
    <h2 class="cfg-section-title">1. Incluir Perfil do Instagram para um Usuário + Configuração da Conta</h2>
    <p class="cfg-section-sub">
        Escolha para qual usuário será este perfil do Instagram (ou crie o usuário junto abaixo) e preencha a configuração exclusiva da conta dele.
    </p>

    <form method="post" asp-page-handler="SalvarContaInstagram">
        @Html.AntiForgeryToken()

        <!-- Vínculo de Usuário -->
        <div style="margin-bottom:16px;padding:15px;background:var(--panel-alt);border:1px solid #442f66;border-radius:11px;">
            <div style="font-size:12px;font-weight:850;color:#ff4f8b;margin-bottom:10px;text-transform:uppercase;letter-spacing:.8px;">
                Passo A — Para qual Usuário é este Perfil do Instagram?
            </div>

            <div class="cfg-grid">
                <div class="cfg-field">
                    <label for="seletorUsuarioVinculo">Selecionar Usuário do Sistema</label>
                    <select id="seletorUsuarioVinculo" name="usuarioAcessoId">
                        <option value="0">+ Criar um Novo Usuário para este Instagram abaixo</option>
                        @foreach (var u in Model.UsuariosAcesso)
                        {
                            <option value="@u.Id">
                                @u.NomeExibicao (Login: @u.Login) @(u.Administrador ? "[Admin]" : "[Usuário]")
                            </option>
                        }
                    </select>
                    <small>O usuário selecionado terá acesso direto a este perfil do Instagram.</small>
                </div>
            </div>

            <div id="blocoCriarNovoUsuario" style="margin-top:14px;padding-top:12px;border-top:1px dashed #3d315b;">
                <div class="cfg-grid">
                    <div class="cfg-field">
                        <label for="novoUsuarioNome">Nome do Novo Usuário / Cliente</label>
                        <input id="novoUsuarioNome"
                               name="novoUsuarioNome"
                               type="text"
                               placeholder="Ex.: Cliente Loja X" />
                    </div>
                    <div class="cfg-field">
                        <label for="novoUsuarioLogin">Login de Acesso do Usuário</label>
                        <input id="novoUsuarioLogin"
                               name="novoUsuarioLogin"
                               type="text"
                               autocapitalize="none"
                               placeholder="Ex.: lojax" />
                    </div>
                    <div class="cfg-field">
                        <label for="novoUsuarioSenha">Senha Inicial do Usuário</label>
                        <input id="novoUsuarioSenha"
                               name="novoUsuarioSenha"
                               type="password"
                               placeholder="Mínimo de 4 caracteres" />
                    </div>
                    <div class="cfg-field" style="justify-content:center;">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:16px;">
                            <input type="checkbox" name="novoUsuarioAdmin" value="true" />
                            Tornar este usuário Administrador também
                        </label>
                        <small>Se desmarcado, ele verá apenas os agendamentos do próprio Instagram.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dados do Perfil do Instagram e Respectiva Configuração -->
        <div style="font-size:12px;font-weight:850;color:#ff4f8b;margin-bottom:10px;text-transform:uppercase;letter-spacing:.8px;">
            Passo B — Perfil do Instagram e Respectiva Configuração (Busca Automática de ID + Token 60 Dias)
        </div>

        <!-- Assistente de Busca Automática pelo Token -->
        <div style="margin-bottom:16px;padding:15px;background:#141b2d;border:1px solid #2e4372;border-radius:11px;">
            <div style="font-size:12px;font-weight:850;color:#38bdf8;margin-bottom:6px;">
                ⚡ Modo Prático: Não precisa procurar o Account ID nem o @@arroba manualmente!
            </div>
            <p style="margin:0 0 12px;font-size:12px;color:#b8c7e0;line-height:1.5;">
                Cole apenas o <strong>Access Token</strong> abaixo e clique em <strong>"🔍 Buscar Instagrams deste Token"</strong> (ou simplesmente salve direto). Se preencher também o <em>App ID</em> e <em>App Secret</em> (opcional), o sistema já transforma o token em <strong>Token de 60 dias</strong> automaticamente!
            </p>

            <div class="cfg-grid">
                <div class="cfg-field">
                    <label for="novoAccessToken">1. Access Token (Meta Graph API)</label>
                    <input id="novoAccessToken"
                           name="accessTokenMeta"
                           type="password"
                           placeholder="Cole aqui o Token EAA... ou IGAA..."
                           required />
                    <small>Cole o token gerado ou do cliente.</small>
                </div>

                <div class="cfg-field">
                    <label for="metaAppIdInput">Meta App ID (opcional — p/ gerar Token 60 dias)</label>
                    <input id="metaAppIdInput"
                           name="metaAppId"
                           type="text"
                           placeholder="Ex.: 123456789012345" />
                    <small>Salvo automaticamente no seu navegador.</small>
                </div>

                <div class="cfg-field">
                    <label for="metaAppSecretInput">Meta App Secret (opcional — p/ gerar Token 60 dias)</label>
                    <input id="metaAppSecretInput"
                           name="metaAppSecret"
                           type="password"
                           placeholder="Chave secreta do Aplicativo Meta" />
                    <small>Se preenchido, converte o token curto p/ 60 dias sozinho.</small>
                </div>

                <div class="cfg-field" style="justify-content:flex-end;">
                    <button type="button"
                            id="btnDescobrirContasToken"
                            class="cfg-btn cfg-btn-secondary"
                            style="background:#1d3557;border-color:#38bdf8;color:#fff;min-height:40px;">
                        🔍 Buscar @@Instagram e ID Sozinho
                    </button>
                </div>
            </div>

            <div id="resultadoBuscaTokenBox" style="display:none;margin-top:12px;padding:12px;background:#0f1523;border:1px solid #334e85;border-radius:9px;">
                <div id="resultadoBuscaTokenStatus" style="font-size:12px;font-weight:800;color:#93c5fd;margin-bottom:8px;"></div>
                <div id="listaContasDescobertas" style="display:flex;flex-wrap:wrap;gap:8px;"></div>
            </div>
        </div>

        <div class="cfg-grid">
            <div class="cfg-field">
                <label for="novoArroba">Qual é o Instagram deste cadastro? (@@perfil — preenchido sozinho se deixar vazio)</label>
                <input id="novoArroba"
                       name="identificadorInstagram"
                       type="text"
                       placeholder="Preenchido automaticamente pelo Token (ou digite @@perfil)" />
                <small>O @@ do perfil do Instagram vinculado.</small>
            </div>

            <div class="cfg-field">
                <label for="novoNomeCadastro">Nome de Identificação do Perfil (preenchido sozinho se deixar vazio)</label>
                <input id="novoNomeCadastro"
                       name="nomeCadastro"
                       type="text"
                       placeholder="Preenchido automaticamente pelo Token" />
                <small>Nome exibido no painel.</small>
            </div>

            <div class="cfg-field">
                <label for="novoAccountId">Instagram Account ID (preenchido sozinho se deixar vazio!)</label>
                <input id="novoAccountId"
                       name="accountIdMeta"
                       type="text"
                       placeholder="Descoberto sozinho pelo Token (ex.: 178414...)" />
                <small>Não precisa procurar! O sistema puxa sozinho pelo Token.</small>
            </div>

            <div class="cfg-field">
                <label for="novoHorariosFeed">Horários diários padrão do Feed (HH:mm)</label>
                <input id="novoHorariosFeed"
                       name="horariosFeed"
                       type="text"
                       value="09:00, 13:00, 18:00"
                       placeholder="09:00, 13:00, 18:00" />
                <small>Horários da fila automática de Feed deste perfil.</small>
            </div>

            <div class="cfg-field">
                <label for="novoHorariosStory">Horários diários padrão dos Stories (HH:mm)</label>
                <input id="novoHorariosStory"
                       name="horariosStory"
                       type="text"
                       value="10:00, 19:00"
                       placeholder="10:00, 19:00" />
                <small>Horários padrão dos Stories recorrentes deste perfil.</small>
            </div>

            <div class="cfg-field">
                <label for="novoBaseUrl">URL Pública deste Sistema</label>
                <input id="novoBaseUrl"
                       name="baseUrlPublica"
                       type="url"
                       value="@Model.BaseUrlDetectada" />
                <small>Usada para servir fotos enviadas do celular/PC à Meta.</small>
            </div>

            <div class="cfg-field" style="justify-content:center;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:8px;">
                    <input type="checkbox" name="publicacaoAutomaticaAtiva" value="true" checked />
                    Publicação automática agendada ativa
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:6px;">
                    <input type="checkbox" name="definirComoPadrao" value="true" />
                    Definir como perfil padrão
                </label>
            </div>
        </div>

        <div style="margin-top:16px;">
            <button type="submit" class="cfg-btn cfg-btn-primary">
                + Incluir Perfil do Instagram e Salvar Configuração
            </button>
        </div>
    </form>
</section>

<!-- 2. PERFIS DO INSTAGRAM CADASTRADOS E SUAS CONFIGURAÇÕES POR USUÁRIO -->
<section class="cfg-section">
    <h2 class="cfg-section-title">2. Perfis do Instagram Cadastrados e Respectivas Configurações (@Model.ContasInstagram.Count)</h2>
    <p class="cfg-section-sub">
        Gerencie cada perfil do Instagram, veja e altere a qual usuário ele pertence, atualize tokens/horários ou teste a conexão com a Meta Graph API.
    </p>

    @if (Model.ContasInstagram.Count == 0)
    {
        <div style="padding:28px;text-align:center;color:var(--muted);">
            Nenhum perfil do Instagram cadastrado ainda. Use o formulário acima para incluir o primeiro perfil.
        </div>
    }
    else
    {
        <div class="cfg-card-list">
            @foreach (var conta in Model.ContasInstagram)
            {
                var tokenConfigurado = !string.IsNullOrWhiteSpace(conta.AccessTokenMeta) && conta.AccessTokenMeta != "PENDENTE";
                var accountConfigurado = !string.IsNullOrWhiteSpace(conta.AccountIdMeta) && conta.AccountIdMeta != "PENDENTE";
                var credenciaisProntas = tokenConfigurado && accountConfigurado;

                <div class="cfg-account-card">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px;">
                        <div>
                            <span style="font-size:16px;font-weight:900;color:#fff;">
                                @conta.IdentificadorInstagram
                            </span>
                            <span style="margin-left:8px;font-size:13px;color:var(--muted);">
                                — <strong style="color:#eadff7;">@conta.NomeCadastro</strong>
                            </span>
                            <span class="cfg-pill user" style="margin-left:8px;">
                                Usuário: @(string.IsNullOrWhiteSpace(conta.LoginUsuarioVinculado) ? "Acesso Admin" : conta.LoginUsuarioVinculado)
                            </span>
                        </div>

                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                            <span class="cfg-pill @(credenciaisProntas && conta.Ativo ? "ok" : "warn")">
                                @( !conta.Ativo ? "Pausado" : credenciaisProntas ? "Configuração Ativa" : "Credenciais Pendentes" )
                            </span>

                            <form method="post" asp-page-handler="TestarConexao" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contaId" value="@conta.Id" />
                                <button type="submit" class="cfg-btn cfg-btn-secondary">
                                    Testar Conexão Meta API
                                </button>
                            </form>

                            <form method="post" asp-page-handler="AlternarContaAtiva" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contaId" value="@conta.Id" />
                                <button type="submit" class="cfg-btn cfg-btn-secondary">
                                    @(conta.Ativo ? "Pausar" : "Ativar")
                                </button>
                            </form>

                            <form method="post"
                                  asp-page-handler="ExcluirConta"
                                  style="margin:0;"
                                  onsubmit="return confirm('Tem certeza que deseja excluir este perfil do Instagram e seus agendamentos?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contaId" value="@conta.Id" />
                                <button type="submit" class="cfg-btn cfg-btn-danger">Excluir</button>
                            </form>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(conta.UltimoTesteStatus))
                    {
                        <div style="margin-bottom:12px;padding:9px 12px;background:#191428;border:1px solid #352b4d;border-radius:8px;font-size:12px;color:#d8c9ee;">
                            <strong>Último teste da API Meta:</strong> @conta.UltimoTesteStatus
                        </div>
                    }

                    <form method="post" asp-page-handler="SalvarContaInstagram">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="contaId" value="@conta.Id" />

                        <div class="cfg-grid">
                            <div class="cfg-field">
                                <label>Usuário Responsável por este Perfil</label>
                                <select name="usuarioAcessoId">
                                    <option value="">Somente Administradores</option>
                                    @foreach (var u in Model.UsuariosAcesso)
                                    {
                                        <option value="@u.Id" selected="@(conta.UsuarioAcessoId == u.Id ? "selected" : null)">
                                            @u.NomeExibicao (@u.Login)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="cfg-field">
                                <label>Instagram (@@perfil)</label>
                                <input type="text" name="identificadorInstagram" value="@conta.IdentificadorInstagram" required />
                            </div>

                            <div class="cfg-field">
                                <label>Nome de Identificação</label>
                                <input type="text" name="nomeCadastro" value="@conta.NomeCadastro" required />
                            </div>

                            <div class="cfg-field">
                                <label>Instagram Account ID (Meta)</label>
                                <input type="text" name="accountIdMeta" value="@conta.AccountIdMeta" required />
                            </div>

                            <div class="cfg-field">
                                <label>Access Token Meta (deixe vazio p/ manter)</label>
                                <input type="password"
                                       name="accessTokenMeta"
                                       placeholder="@(tokenConfigurado ? "•••••••• (Token salvo)" : "Cole o Access Token")" />
                            </div>

                            <div class="cfg-field">
                                <label>Horários diários Feed (HH:mm)</label>
                                <input type="text"
                                       name="horariosFeed"
                                       value="@Model.FormatarHorarios(conta.HorariosFeedJson, "09:00, 13:00, 18:00")" />
                            </div>

                            <div class="cfg-field">
                                <label>Horários diários Stories (HH:mm)</label>
                                <input type="text"
                                       name="horariosStory"
                                       value="@Model.FormatarHorarios(conta.HorariosStoryJson, "10:00, 19:00")" />
                            </div>

                            <div class="cfg-field" style="justify-content:flex-end;">
                                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                                    <input type="checkbox"
                                           name="publicacaoAutomaticaAtiva"
                                           value="true"
                                           @(conta.PublicacaoAutomaticaAtiva ? "checked" : null) />
                                    Publicação automática ativa
                                </label>
                                <button type="submit" class="cfg-btn cfg-btn-primary" style="margin-top:6px;">
                                    Salvar Configuração deste Perfil
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            }
        </div>
    }
</section>

<!-- 3. GERENCIAMENTO DE USUÁRIOS E SEUS RESPECTIVOS PERFIS VINCULADOS -->
<section class="cfg-section">
    <h2 class="cfg-section-title">3. Usuários Cadastrados e Controle de Acesso (@Model.UsuariosAcesso.Count)</h2>
    <p class="cfg-section-sub">
        Crie novos usuários, redefina senhas, altere o perfil do Instagram vinculado a cada usuário ou defina quem é Administrador.
    </p>

    <form method="post"
          asp-page-handler="SalvarUsuario"
          style="padding:16px;background:var(--panel-alt);border:1px solid var(--border);border-radius:12px;margin-bottom:18px;">
        @Html.AntiForgeryToken()

        <div class="cfg-grid" style="align-items:end;">
            <div class="cfg-field">
                <label for="usrNome">Nome do Usuário / Cliente</label>
                <input id="usrNome"
                       name="nomeExibicao"
                       type="text"
                       placeholder="Ex.: Maria - Loja 2"
                       required />
            </div>

            <div class="cfg-field">
                <label for="usrLogin">Usuário (Login)</label>
                <input id="usrLogin"
                       name="login"
                       type="text"
                       autocapitalize="none"
                       placeholder="Ex.: maria"
                       required />
            </div>

            <div class="cfg-field">
                <label for="usrSenha">Senha</label>
                <input id="usrSenha"
                       name="senha"
                       type="password"
                       placeholder="Mínimo de 4 caracteres"
                       required />
            </div>

            <div class="cfg-field">
                <label for="usrContaIg">Perfil do Instagram deste Usuário</label>
                <select id="usrContaIg" name="instagramContaId">
                    <option value="">Selecionar perfil do Instagram...</option>
                    @foreach (var conta in Model.ContasInstagram)
                    {
                        <option value="@conta.Id">
                            @conta.IdentificadorInstagram (@conta.NomeCadastro)
                        </option>
                    }
                </select>
            </div>

            <div class="cfg-field">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px;">
                    <input type="checkbox" name="administrador" value="true" />
                    Acesso de Administrador
                </label>
                <button type="submit" class="cfg-btn cfg-btn-primary">
                    + Cadastrar Usuário
                </button>
            </div>
        </div>
    </form>

    <div class="cfg-card-list">
        @foreach (var usr in Model.UsuariosAcesso)
        {
            <div class="cfg-account-card">
                <form method="post" asp-page-handler="SalvarUsuario">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="usuarioId" value="@usr.Id" />

                    <div class="cfg-grid" style="align-items:end;">
                        <div class="cfg-field">
                            <label>Nome do Usuário</label>
                            <input type="text" name="nomeExibicao" value="@usr.NomeExibicao" required />
                        </div>

                        <div class="cfg-field">
                            <label>Login</label>
                            <input type="text" name="login" value="@usr.Login" required />
                        </div>

                        <div class="cfg-field">
                            <label>Perfil do Instagram Vinculado</label>
                            <select name="instagramContaId">
                                <option value="">@(usr.Administrador ? "Todos os Perfis (Admin)" : "Nenhum perfil selecionado")</option>
                                @foreach (var conta in Model.ContasInstagram)
                                {
                                    <option value="@conta.Id"
                                            selected="@(usr.InstagramContaId == conta.Id ? "selected" : null)">
                                        @conta.IdentificadorInstagram — @conta.NomeCadastro
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="cfg-field">
                            <label>Nova Senha (vazio p/ manter)</label>
                            <input type="password" name="senha" placeholder="••••••••" />
                        </div>

                        <div class="cfg-field">
                            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:8px;">
                                <input type="checkbox"
                                       name="administrador"
                                       value="true"
                                       @(usr.Administrador ? "checked" : null) />
                                Administrador
                            </label>
                            <button type="submit" class="cfg-btn cfg-btn-secondary">Salvar Usuário</button>
                        </div>
                    </div>
                </form>

                <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;align-items:center;">
                    @{
                        var linkConvite = Model.GerarLinkConviteCliente(usr.Id);
                    }
                    <button type="button"
                            class="cfg-btn"
                            style="background:#1877f2;color:#fff;"
                            onclick="navigator.clipboard.writeText('@linkConvite'); this.textContent='✅ Link Copiado! Mande no WhatsApp do Cliente';">
                        📲 Copiar Link 1-Clique p/ @usr.NomeExibicao Conectar o Instagram
                    </button>

                    @if (Model.UsuariosAcesso.Count > 1)
                    {
                        <form method="post"
                              asp-page-handler="ExcluirUsuario"
                              style="margin:0;"
                              onsubmit="return confirm('Deseja remover este usuário?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="usuarioId" value="@usr.Id" />
                            <button type="submit" class="cfg-btn cfg-btn-danger">Excluir Usuário</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</section>

<script>
    (() => {
        const selectUsr = document.getElementById("seletorUsuarioVinculo");
        const blocoNovoUsr = document.getElementById("blocoCriarNovoUsuario");
        if (selectUsr && blocoNovoUsr) {
            const atualizar = () => {
                blocoNovoUsr.style.display = selectUsr.value === "0" ? "block" : "none";
            };
            selectUsr.addEventListener("change", atualizar);
            atualizar();
        }

        const appIdInput = document.getElementById("metaAppIdInput");
        const appSecretInput = document.getElementById("metaAppSecretInput");
        try {
            if (appIdInput) {
                appIdInput.value = localStorage.getItem("agendador_meta_appid") || "";
                appIdInput.addEventListener("change", () => localStorage.setItem("agendador_meta_appid", appIdInput.value.trim()));
            }
            if (appSecretInput) {
                appSecretInput.value = localStorage.getItem("agendador_meta_appsecret") || "";
                appSecretInput.addEventListener("change", () => localStorage.setItem("agendador_meta_appsecret", appSecretInput.value.trim()));
            }
        } catch { }

        const btnDescobrir = document.getElementById("btnDescobrirContasToken");
        const inputToken = document.getElementById("novoAccessToken");
        const inputArroba = document.getElementById("novoArroba");
        const inputNome = document.getElementById("novoNomeCadastro");
        const inputAccountId = document.getElementById("novoAccountId");
        const boxResultado = document.getElementById("resultadoBuscaTokenBox");
        const statusResultado = document.getElementById("resultadoBuscaTokenStatus");
        const listaContas = document.getElementById("listaContasDescobertas");

        if (btnDescobrir && inputToken) {
            btnDescobrir.addEventListener("click", async () => {
                const accessToken = inputToken.value.trim();
                if (!accessToken) {
                    alert("Cole o Access Token primeiro para buscar os Instagrams vinculados.");
                    inputToken.focus();
                    return;
                }

                btnDescobrir.disabled = true;
                btnDescobrir.textContent = "⏳ Buscando na Meta...";
                if (boxResultado) boxResultado.style.display = "block";
                if (statusResultado) statusResultado.textContent = "Consultando páginas e contas de Instagram vinculadas a este Token...";
                if (listaContas) listaContas.innerHTML = "";

                try {
                    const res = await fetch("/api/meta/descobrir-contas", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            accessToken,
                            appId: appIdInput ? appIdInput.value.trim() : "",
                            appSecret: appSecretInput ? appSecretInput.value.trim() : ""
                        })
                    });

                    const dados = await res.json();
                    if (!res.ok || !dados.sucesso) {
                        throw new Error(dados.erro || "Não foi possível consultar o token na Meta.");
                    }

                    const contas = dados.contas || [];
                    if (contas.length === 0) {
                        if (statusResultado) {
                            statusResultado.textContent = "⚠️ Nenhuma conta Instagram Comercial/Business foi encontrada neste Token. Verifique se o Instagram está conectado a uma Página do Facebook e se você marcou as páginas ao gerar o Token.";
                        }
                        return;
                    }

                    const aplicarConta = (c) => {
                        if (inputArroba) inputArroba.value = c.identificadorInstagram || "";
                        if (inputNome) inputNome.value = c.nomeExibicao || "";
                        if (inputAccountId) inputAccountId.value = c.accountIdMeta || "";
                        if (c.accessTokenFinal && inputToken) inputToken.value = c.accessTokenFinal;
                    };

                    // Já preenche a primeira automaticamente
                    aplicarConta(contas[0]);

                    const msg60d = contas[0].tokenConvertido60Dias
                        ? " (Token já convertido para 60 dias automaticamente!)"
                        : "";

                    if (statusResultado) {
                        statusResultado.textContent = `✅ ${contas.length} conta(s) encontrada(s)${msg60d}! Clique em uma conta abaixo para preencher:`;
                    }

                    contas.forEach(c => {
                        const btn = document.createElement("button");
                        btn.type = "button";
                        btn.className = "cfg-btn cfg-btn-secondary";
                        btn.style.borderColor = "#38bdf8";
                        btn.textContent = `${c.identificadorInstagram} (${c.nomeExibicao}) · ID: ${c.accountIdMeta}`;
                        btn.addEventListener("click", () => {
                            aplicarConta(c);
                            if (statusResultado) {
                                statusResultado.textContent = `✅ Selecionado: ${c.identificadorInstagram} (ID: ${c.accountIdMeta})${msg60d}`;
                            }
                        });
                        listaContas?.appendChild(btn);
                    });
                } catch (err) {
                    if (statusResultado) {
                        statusResultado.textContent = `❌ Erro: ${err.message}`;
                    }
                } finally {
                    btnDescobrir.disabled = false;
                    btnDescobrir.textContent = "🔍 Buscar @@Instagram e ID Sozinho";
                }
            });
        }
    })();
</script>
