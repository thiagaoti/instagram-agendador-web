@page
@model InstagramAgendador.Web.Pages.ConectarInstagramModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0b14" />
    <title>Conectar Instagram em 1 Clique - Agendador Pro</title>
    <link rel="icon" href="~/pwa/icon.svg?v=2" type="image/svg+xml" />
    <style>
        :root {
            color-scheme: dark;
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            background: #0d0b14;
            color: #f5effa;
        }
        * { box-sizing: border-box; }
        body {
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            display: grid;
            place-items: center;
            background:
                radial-gradient(circle at 20% 15%, #1d4ed826 0%, transparent 40%),
                radial-gradient(circle at 80% 85%, #a855f724 0%, transparent 40%),
                #0d0b14;
        }
        .card {
            width: min(100%, 520px);
            padding: 30px 24px;
            background: #181424;
            border: 1px solid #2d2542;
            border-radius: 18px;
            box-shadow: 0 24px 70px #0009;
        }
        .badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 7px;
            background: #172554;
            border: 1px solid #3b82f6;
            color: #93c5fd;
            font-size: 11px;
            font-weight: 850;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }
        h1 {
            margin: 0 0 10px;
            font-size: 24px;
            font-weight: 900;
        }
        p {
            margin: 0 0 18px;
            color: #b1a5c4;
            font-size: 13.5px;
            line-height: 1.6;
        }
        .steps {
            padding: 14px 16px;
            background: #120f1c;
            border: 1px solid #2b2340;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 12.5px;
            color: #ddd2ee;
            line-height: 1.65;
        }
        .btn-fb {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            min-height: 48px;
            padding: 12px 18px;
            background: #1877f2;
            color: #ffffff;
            border: 0;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 850;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 8px 25px #1877f244;
        }
        .btn-fb:hover {
            background: #166fe5;
        }
        .btn-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 42px;
            margin-top: 12px;
            padding: 10px 16px;
            background: #231c35;
            border: 1px solid #3d315b;
            border-radius: 10px;
            color: #eadff7;
            font-size: 13px;
            font-weight: 750;
            text-decoration: none;
            cursor: pointer;
        }
        .alert-ok {
            padding: 16px;
            margin-bottom: 18px;
            border-radius: 12px;
            background: #153224;
            border: 1px solid #285c40;
            color: #9af0b9;
            font-size: 13.5px;
            line-height: 1.5;
        }
        .alert-err {
            padding: 16px;
            margin-bottom: 18px;
            border-radius: 12px;
            background: #3b1c26;
            border: 1px solid #7b3248;
            color: #ffb4b4;
            font-size: 13px;
            line-height: 1.5;
        }
        .ig-option {
            padding: 14px;
            margin-bottom: 10px;
            background: #120f1c;
            border: 1px solid #3d315b;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }
    </style>
</head>
<body>
    <main class="card">
        <span class="badge">Conexão Oficial em 1 Clique</span>
        <h1>Conectar seu Instagram</h1>

        @if (Model.UsuarioAlvo is not null)
        {
            <p>
                Olá, <strong>@Model.UsuarioAlvo.NomeExibicao</strong>! Clique no botão abaixo para autorizar a publicação automática de Feed e Stories no seu Instagram.
            </p>
        }
        else
        {
            <p>
                Clique no botão abaixo para entrar com o Facebook vinculado ao seu Instagram Comercial e configurar sua conta automaticamente.
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.MensagemSucesso))
        {
            <div class="alert-ok">
                <strong>✅ Tudo pronto!</strong><br />
                @Model.MensagemSucesso
            </div>
            <a href="/" class="btn-fb" style="background:linear-gradient(90deg,#ff4f8b,#ff7a59);color:#16050c;">
                Ir para o Painel de Agendamentos →
            </a>
        }
        else if (Model.ContasDescobertas.Count > 0)
        {
            <p>Encontramos <strong>@Model.ContasDescobertas.Count perfis do Instagram</strong> na sua conta. Clique em qual deseja conectar:</p>
            @foreach (var c in Model.ContasDescobertas)
            {
                <form method="post" asp-page-handler="SelecionarConta" class="ig-option">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="uid" value="@Model.Uid" />
                    <input type="hidden" name="sig" value="@Model.Sig" />
                    <input type="hidden" name="accountIdMeta" value="@c.AccountIdMeta" />
                    <input type="hidden" name="identificadorInstagram" value="@c.IdentificadorInstagram" />
                    <input type="hidden" name="nomeExibicao" value="@c.NomeExibicao" />
                    <input type="hidden" name="accessTokenFinal" value="@c.AccessTokenFinal" />
                    <div>
                        <strong style="color:#fff;font-size:15px;">@c.IdentificadorInstagram</strong>
                        <div style="font-size:12px;color:#9d91b0;">@c.NomeExibicao (ID: @c.AccountIdMeta)</div>
                    </div>
                    <button type="submit" class="btn-fb" style="width:auto;min-height:38px;padding:8px 16px;font-size:12.5px;">
                        ✅ Conectar este Instagram
                    </button>
                </form>
            }
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(Model.MensagemErro))
            {
                <div class="alert-err">@Model.MensagemErro</div>
            }

            <div class="steps">
                <strong>Antes de clicar, confirme apenas 2 detalhes no seu celular:</strong>
                <ol style="margin:8px 0 0;padding-left:18px;">
                    <li>O seu Instagram está como <strong>Conta Empresarial (Empresa)</strong>.</li>
                    <li>O seu Instagram está conectado à sua <strong>Página do Facebook</strong>.</li>
                </ol>
            </div>

            <a href="/ConectarInstagram?handler=IniciarOAuth&uid=@Model.Uid&sig=@Model.Sig" class="btn-fb">
                🔵 Continuar com Facebook e Conectar Instagram
            </a>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="/" class="btn-secondary">← Voltar para o Aplicativo</a>
        }
    </main>
</body>
</html>
