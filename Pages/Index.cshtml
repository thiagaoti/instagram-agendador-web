@page
@model InstagramAgendador.Web.Pages.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Central de Agendamento Instagram";
    var cultura = CultureInfo.GetCultureInfo("pt-BR");
    var proximoSlotPadrao = Model.ProximosSlotsConta.Count > 0
        ? Model.ProximosSlotsConta[0]
        : Model.AgoraSaoPaulo.AddHours(1);
}

<style>
    .dash-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .dash-eyebrow {
        color: var(--accent);
        font-size: 11px;
        font-weight: 850;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .dash-title {
        margin: 0;
        font-size: clamp(25px, 3.8vw, 34px);
        font-weight: 900;
    }

    .dash-sub {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 13px;
        max-width: 780px;
        line-height: 1.6;
    }

    .account-switcher {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
        flex-wrap: wrap;
        max-width: 100%;
        min-width: 0;
    }

    .account-switcher select {
        padding: 8px 12px;
        background: var(--panel-alt);
        color: #fff;
        border: 1px solid #453668;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 800;
        max-width: 100%;
        min-width: 0;
    }

    .dash-alert {
        padding: 13px 16px;
        margin-bottom: 18px;
        border-radius: 10px;
        background: #153224;
        border: 1px solid #285c40;
        color: #9af0b9;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .dash-alert.erro {
        background: #3b1c26;
        border-color: #7b3248;
        color: #ffb4b4;
    }

    .dash-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 155px), 1fr));
        gap: 12px;
        margin-bottom: 24px;
        min-width: 0;
    }

    .metric-box {
        padding: 15px 17px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 11px;
        min-width: 0;
        overflow: hidden;
    }

    .metric-label {
        font-size: 11px;
        font-weight: 750;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .metric-val {
        margin-top: 6px;
        font-size: 24px;
        font-weight: 900;
        color: #fff;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .metric-val.pink { color: var(--accent); }
    .metric-val.green { color: var(--success); }
    .metric-val.warn { color: var(--warn); font-size: 16px; margin-top: 10px; }

    .dash-section {
        padding: 22px;
        margin-bottom: 24px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
    }

    .dash-section.studio-highlight {
        background: linear-gradient(160deg, #1b1530 0%, #141224 100%);
        border: 1px solid #4c3575;
        box-shadow: 0 14px 40px #0000004d;
    }

    .dash-section-title {
        margin: 0 0 4px;
        font-size: 18px;
        font-weight: 850;
    }

    .dash-section-desc {
        margin: 0 0 18px;
        color: var(--muted);
        font-size: 12.5px;
        line-height: 1.5;
    }

    .split-layout {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr);
        gap: 18px;
        align-items: start;
        min-width: 0;
        max-width: 100%;
    }

    .split-layout-studio {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 20px;
        align-items: start;
        min-width: 0;
        max-width: 100%;
    }

    .preview-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        min-width: 0;
        max-width: 100%;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 215px), 1fr));
        gap: 14px;
        min-width: 0;
        max-width: 100%;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        max-width: 100%;
    }

    .field label {
        font-size: 11.5px;
        font-weight: 750;
        color: #e2d7f0;
    }

    .field input,
    .field select,
    .field textarea {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 9px 11px;
        background: var(--panel-alt);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font-size: 12.5px;
    }

    .field small {
        font-size: 10.5px;
        color: var(--muted);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 38px;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        border: 1px solid transparent;
        text-decoration: none;
        max-width: 100%;
        text-align: center;
    }

    .btn-primary {
        background: linear-gradient(90deg, #ff4f8b, #ff7a59);
        color: #16050c;
    }

    .btn-ai {
        background: linear-gradient(90deg, #06b6d4, #6366f1, #a855f7);
        color: #ffffff;
        box-shadow: 0 6px 20px #6366f144;
    }

    .btn-secondary {
        background: #231c35;
        border-color: #3d315b;
        color: #eadff7;
    }

    .btn-danger {
        background: #381924;
        border-color: #6e2b42;
        color: #ffb4b4;
    }

    .queue-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-width: 0;
    }

    .queue-item {
        display: grid;
        grid-template-columns: 105px minmax(0, 1fr);
        gap: 16px;
        padding: 16px;
        background: var(--panel-alt);
        border: 1px solid var(--border);
        border-radius: 12px;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
    }

    .queue-item > div {
        min-width: 0;
        max-width: 100%;
    }

    .pill {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 850;
        text-transform: uppercase;
    }

    .pill.agendado { background: #14283b; color: #72d2ff; border: 1px solid #204c73; }
    .pill.publicado { background: #153224; color: #9af0b9; border: 1px solid #285c40; }
    .pill.falha { background: #3b1c26; color: #ffb4b4; border: 1px solid #7b3248; }
    .pill.cancelado { background: #211d29; color: #9d91b0; border: 1px solid #352e42; }

    .days-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 2px;
    }

    .day-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        background: var(--panel-alt);
        border: 1px solid #3a2e56;
        border-radius: 8px;
        font-size: 11.5px;
        font-weight: 800;
        color: #dfd3f2;
        cursor: pointer;
        user-select: none;
    }

    .day-chip input[type="checkbox"] {
        width: 14px;
        height: 14px;
        margin: 0;
        accent-color: #ff4f8b;
        cursor: pointer;
    }

    /* Calendário Mensal com Miniaturas Redondas */
    .cal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .cal-nav {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 8px;
    }

    .cal-weekday {
        text-align: center;
        font-size: 11px;
        font-weight: 850;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 6px 4px;
    }

    .cal-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 8px;
    }

    .cal-day {
        min-height: 112px;
        padding: 8px 6px;
        background: var(--panel-alt);
        border: 1px solid var(--border);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        overflow: hidden;
    }

    .cal-day.empty {
        background: #100d19;
        border-color: #1f1930;
        opacity: 0.45;
    }

    .cal-day.today {
        border-color: var(--accent);
        box-shadow: inset 0 0 0 1px #ff4f8b66;
        background: linear-gradient(180deg, #21152b 0%, #120f1c 100%);
    }

    .cal-day-num {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        font-weight: 850;
        color: #cfc3e4;
        padding: 0 2px;
    }

    .cal-day.today .cal-day-num span:first-child {
        background: var(--accent);
        color: #16050c;
        padding: 2px 7px;
        border-radius: 999px;
        font-size: 11px;
    }

    .cal-items {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
        align-items: flex-start;
        margin-top: 2px;
    }

    .cal-post-bubble {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        width: 68px;
        max-width: 100%;
        transition: transform .15s ease;
    }

    .cal-post-bubble:hover {
        transform: translateY(-2px);
    }

    .cal-thumb-ring {
        width: 46px;
        height: 46px;
        padding: 2.5px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff4f8b, #ff7a59, #a855f7);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        box-shadow: 0 4px 12px #00000066;
    }

    .cal-thumb-ring.publicado {
        background: linear-gradient(135deg, #10b981, #39e58c);
    }

    .cal-thumb-ring.falha {
        background: linear-gradient(135deg, #ef4444, #ff7b7b);
    }

    .cal-thumb-ring img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        background: #0d0b14;
        border: 2px solid #120f1c;
    }

    .cal-bubble-time {
        position: absolute;
        bottom: -4px;
        background: #0d0b14;
        color: #ffd089;
        border: 1px solid #473869;
        border-radius: 6px;
        padding: 1px 4px;
        font-size: 8.5px;
        font-weight: 850;
        line-height: 1.1;
    }

    .cal-bubble-handle {
        margin-top: 5px;
        font-size: 9.5px;
        font-weight: 800;
        color: #f5effa;
        max-width: 68px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-align: center;
    }

    @@media (max-width: 780px) {
        .cal-weekdays {
            display: none;
        }
        .cal-grid {
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 145px), 1fr));
        }
        .cal-day.empty {
            display: none;
        }
        .cal-day {
            min-height: 92px;
        }
    }

    @@media (max-width: 780px) {
        .split-layout,
        .split-layout-studio,
        .queue-item {
            grid-template-columns: 1fr;
        }

        .dash-section {
            padding: 15px 12px;
            border-radius: 12px;
        }

        .queue-item {
            padding: 13px 11px;
        }

        .account-switcher {
            width: 100%;
            padding: 10px 12px;
        }

        .account-switcher form {
            width: 100%;
        }

        .account-switcher select {
            width: 100%;
        }
    }
</style>

<div class="dash-header">
    <div>
        <div class="dash-eyebrow">SISTEMA EXCLUSIVO DE AGENDAMENTO INSTAGRAM</div>
        <h1 class="dash-title">Central de Publicações (Feed & Stories)</h1>
        <p class="dash-sub">
            Escolha para qual Instagram deseja agendar, suba a foto ou arte do seu celular/PC, personalize a legenda e programe o disparo automático.
        </p>
    </div>

    <div class="account-switcher">
        <form method="get" style="display:flex;align-items:center;gap:10px;margin:0;flex-wrap:wrap;">
            <label for="seletorContaTopo" style="font-size:12px;font-weight:800;color:#e2d7f0;">
                Instagram Ativo:
            </label>
            <select id="seletorContaTopo" name="ContaId" onchange="this.form.submit()">
                @if (Model.ContasDisponiveis.Count == 0)
                {
                    <option value="">Nenhum Instagram cadastrado</option>
                }
                else
                {
                    @foreach (var c in Model.ContasDisponiveis)
                    {
                        <option value="@c.Id" selected="@(Model.ContaSelecionada?.Id == c.Id ? "selected" : null)">
                            @c.IdentificadorInstagram (@c.NomeCadastro)
                        </option>
                    }
                }
            </select>
        </form>
        @if (Model.EhAdmin)
        {
            <a href="/Configuracoes" class="btn btn-secondary">
                ⚙ Incluir Perfis / Usuários (Admin)
            </a>
        }
    </div>
</div>

@if (TempData["Mensagem"] is string mensagem)
{
    <div class="dash-alert @(TempData["TipoMensagem"]?.ToString() == "erro" ? "erro" : "")" role="status">
        @mensagem
    </div>
}

@if (Model.ContasDisponiveis.Count == 0)
{
    <section class="dash-section" style="text-align:center;padding:38px 24px;">
        @if (Model.EhAdmin)
        {
            <h2 style="margin:0 0 10px;font-size:22px;">Inclua o primeiro Perfil do Instagram para começar!</h2>
            <p style="color:var(--muted);max-width:560px;margin:0 auto 20px;font-size:13.5px;line-height:1.6;">
                Como Administrador, acesse a tela de Configurações para cadastrar os usuários e incluir o perfil do Instagram (@@perfil, Account ID e Access Token) com a respectiva configuração de cada usuário.
            </p>
            <a href="/Configuracoes" class="btn btn-primary" style="padding:12px 22px;font-size:13px;">
                Ir para Tela de Configuração (Admin) →
            </a>
        }
        else
        {
            <h2 style="margin:0 0 10px;font-size:22px;">Conecte o seu Perfil do Instagram</h2>
            <p style="color:var(--muted);max-width:560px;margin:0 auto 18px;font-size:13.5px;line-height:1.6;">
                Clique no botão abaixo para conectar o seu Instagram Comercial em 1 clique pelo Facebook, ou solicite ao <strong>Administrador</strong> que vincule o seu perfil.
            </p>
            <a href="/ConectarInstagram" class="btn" style="background:#1877f2;color:#fff;padding:12px 22px;font-size:13.5px;">
                🔵 Conectar meu Instagram com Facebook (1 Clique)
            </a>
        }
    </section>
}
else
{
    <section class="dash-metrics">
        <div class="metric-box">
            <div class="metric-label">Instagram Selecionado</div>
            <div class="metric-val pink" style="font-size:18px;margin-top:9px;">
                @(Model.ContaSelecionada?.IdentificadorInstagram ?? "--")
            </div>
        </div>
        <div class="metric-box">
            <div class="metric-label">Posts na Fila</div>
            <div class="metric-val">@Model.TotalPostsNaFila</div>
        </div>
        <div class="metric-box">
            <div class="metric-label">Stories Automáticos Ativos</div>
            <div class="metric-val green">@Model.TotalStoriesAtivos</div>
        </div>
        <div class="metric-box">
            <div class="metric-label">Total Publicados</div>
            <div class="metric-val">@Model.TotalPublicados</div>
        </div>
        <div class="metric-box">
            <div class="metric-label">Próximo Horário Livre</div>
            <div class="metric-val warn">
                @proximoSlotPadrao.ToString("dd/MM 'às' HH:mm", cultura)
            </div>
        </div>
    </section>

    <!-- CALENDÁRIO MENSAL VISUAL COM MINIATURA REDONDA E PERFIL EMBAIXO -->
    var primeiroDiaMes = new DateTime(Model.AnoCalendario, Model.MesCalendario, 1);
    var diasNoMes = DateTime.DaysInMonth(Model.AnoCalendario, Model.MesCalendario);
    var offsetInicioSemana = (int)primeiroDiaMes.DayOfWeek; // 0 = Dom .. 6 = Sáb
    var mesAnterior = primeiroDiaMes.AddMonths(-1);
    var proximoMes = primeiroDiaMes.AddMonths(1);
    var nomeMesAno = cultura.TextInfo.ToTitleCase(primeiroDiaMes.ToString("MMMM 'de' yyyy", cultura));
    var nomesSemanaCurto = new[] { "Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb" };
    <section class="dash-section">
        <div class="cal-header">
            <div>
                <h2 class="dash-section-title">📅 Calendário do Mês — @nomeMesAno</h2>
                <p class="dash-section-desc" style="margin-bottom:0;">
                    Visão mensal com a miniatura redonda de cada publicação e o nome do <code>@@instagram</code> logo abaixo. Toque na miniatura para ir direto ao agendamento.
                </p>
            </div>

            <div class="cal-nav">
                <a href="/?ContaId=@Model.ContaId&Mes=@mesAnterior.Month&Ano=@mesAnterior.Year"
                   class="btn btn-secondary">
                    ◀ @cultura.TextInfo.ToTitleCase(mesAnterior.ToString("MMM", cultura))
                </a>
                <a href="/?ContaId=@Model.ContaId&Mes=@Model.AgoraSaoPaulo.Month&Ano=@Model.AgoraSaoPaulo.Year"
                   class="btn btn-secondary">
                    Hoje
                </a>
                <a href="/?ContaId=@Model.ContaId&Mes=@proximoMes.Month&Ano=@proximoMes.Year"
                   class="btn btn-secondary">
                    @cultura.TextInfo.ToTitleCase(proximoMes.ToString("MMM", cultura)) ▶
                </a>
            </div>
        </div>

        <div class="cal-weekdays">
            @foreach (var nomeSem in nomesSemanaCurto)
            {
                <div class="cal-weekday">@nomeSem</div>
            }
        </div>

        <div class="cal-grid">
            @for (var i = 0; i < offsetInicioSemana; i++)
            {
                <div class="cal-day empty" aria-hidden="true"></div>
            }

            @for (var dia = 1; dia <= diasNoMes; dia++)
            {
                var dataAtual = new DateTime(Model.AnoCalendario, Model.MesCalendario, dia);
                var ehHoje = dataAtual.Date == Model.AgoraSaoPaulo.Date;
                Model.CalendarioPorDia.TryGetValue(dia, out var itensDia);
                var qtdItens = itensDia?.Count ?? 0;

                <div class="cal-day @(ehHoje ? "today" : "")">
                    <div class="cal-day-num">
                        <span>@dia.ToString("00") · @nomesSemanaCurto[(int)dataAtual.DayOfWeek]</span>
                        @if (qtdItens > 0)
                        {
                            <small style="font-size:10px;color:var(--accent);">@qtdItens post(s)</small>
                        }
                    </div>

                    @if (itensDia is { Count: > 0 })
                    {
                        <div class="cal-items">
                            @foreach (var item in itensDia)
                            {
                                <a href="@item.AncoraAlvo"
                                   class="cal-post-bubble"
                                   title="@item.IdentificadorInstagram · @item.Titulo (@item.TipoMidia às @item.HorarioTexto)">
                                    <span class="cal-thumb-ring @item.StatusClasse">
                                        <img src="@item.UrlMiniatura"
                                             alt="@item.Titulo"
                                             loading="lazy" />
                                        <span class="cal-bubble-time">@item.HorarioTexto</span>
                                    </span>
                                    <span class="cal-bubble-handle">@item.IdentificadorInstagram</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- 1. AGENDAR NOVO POST (FEED, CARROSSEL, VÍDEO/REELS OU STORIES) -->
    <section class="dash-section">
        <h2 class="dash-section-title">1. Agendar Nova Publicação (Foto, Vídeo/Reels ou Carrossel)</h2>
        <p class="dash-section-desc">
            Envie <strong>1 foto</strong>, <strong>1 vídeo (MP4/MOV)</strong> ou selecione <strong>de 2 a 10 fotos/vídeos juntos para montar um Carrossel no Feed</strong>, escolha o Instagram, escreva a legenda e agende.
        </p>

        <form method="post"
              asp-page-handler="CriarPostAgendado"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="split-layout">
                <div class="preview-col">
                    <div style="width:155px;height:155px;background:var(--panel-alt);border:1px dashed #473869;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:8px;text-align:center;color:var(--muted);font-size:11px;">
                        <img id="postPreviewImg" alt="Prévia do Post" style="display:none;width:100%;height:100%;object-fit:cover;" />
                        <video id="postPreviewVideo" controls muted playsinline style="display:none;width:100%;height:100%;object-fit:cover;"></video>
                        <span id="postPreviewText">Prévia de Foto, Vídeo ou Carrossel</span>
                    </div>
                    <small id="postPreviewCaption" style="color:var(--muted);font-size:10px;text-align:center;">Foto (JPG/PNG) ou Vídeo (MP4/MOV até 55 MB)</small>
                </div>

                <div style="min-width:0;max-width:100%;">
                    <div class="form-grid">
                        <div class="field">
                            <label for="postContaIg">Para qual Instagram vai este post?</label>
                            <select id="postContaIg" name="instagramContaId" required>
                                @foreach (var conta in Model.ContasDisponiveis)
                                {
                                    <option value="@conta.Id" selected="@(Model.ContaSelecionada?.Id == conta.Id ? "selected" : null)">
                                        @conta.IdentificadorInstagram — @conta.NomeCadastro
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="field">
                            <label for="postTitulo">Título de identificação</label>
                            <input id="postTitulo"
                                   name="titulo"
                                   type="text"
                                   placeholder="Ex.: Post Oferta do Dia / Vídeo / Carrossel"
                                   required />
                        </div>

                        <div class="field">
                            <label for="postTipo">Onde e formato da publicação?</label>
                            <select id="postTipo" name="tipoPublicacao">
                                <option value="@TipoMidiaInstagram.Feed">Somente no Feed (Foto ou Vídeo/Reels)</option>
                                <option value="@TipoMidiaInstagram.FeedCarrossel">Carrossel no Feed (2 a 10 Fotos e/ou Vídeos)</option>
                                <option value="@TipoMidiaInstagram.FeedEStories">No Feed + Nos Stories (Foto ou Vídeo)</option>
                                <option value="@TipoMidiaInstagram.Stories">Somente nos Stories (Foto ou Vídeo)</option>
                            </select>
                        </div>

                        <div class="field">
                            <label for="postArquivo">Subir Foto(s) ou Vídeo(s) do celular/PC</label>
                            <input id="postArquivo"
                                   name="arquivosMidia"
                                   type="file"
                                   multiple
                                   accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime" />
                            <small>Para Carrossel, selecione de 2 a 10 arquivos de uma só vez.</small>
                        </div>

                        <div class="field">
                            <label for="postUrlExterna">Ou URL pública da foto/vídeo (opcional)</label>
                            <input id="postUrlExterna"
                                   name="urlImagemExterna"
                                   type="url"
                                   placeholder="https://..." />
                        </div>

                        <div class="field">
                            <label for="postModoHorario">Quando postar?</label>
                            <select id="postModoHorario" name="modoHorario">
                                <option value="auto" selected>
                                    Próximo horário livre (@proximoSlotPadrao.ToString("dd/MM HH:mm"))
                                </option>
                                <option value="dias_semana">Repetir toda semana no(s) Dia(s) da Semana + Horário</option>
                                <option value="manual">Escolher data e hora específica (1 vez)</option>
                            </select>
                        </div>

                        <div class="field" id="campoHorarioManualPost" style="display:none;">
                            <label for="postHorarioManual">Data e hora (America/Sao_Paulo)</label>
                            <input id="postHorarioManual"
                                   name="horarioEspecificoLocal"
                                   type="datetime-local"
                                   value="@proximoSlotPadrao.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture)" />
                        </div>

                        <div class="field" id="campoHorarioDiaSemanaPost" style="display:none;">
                            <label for="postHorarioDiaSemana">Horário nos dias escolhidos (HH:mm)</label>
                            <input id="postHorarioDiaSemana"
                                   name="horarioDiaSemanaPost"
                                   type="time"
                                   value="@proximoSlotPadrao.ToString("HH:mm", CultureInfo.InvariantCulture)" />
                        </div>
                    </div>

                    <div class="field" id="blocoDiasSemanaPost" style="display:none;margin-top:12px;">
                        <label>Escolha em qual(is) dia(s) da semana deseja agendar esta publicação:</label>
                        <div class="days-grid">
                            @{
                                var nomesDias = new (int Valor, string Nome)[]
                                {
                                    (1, "Segunda"), (2, "Terça"), (3, "Quarta"), (4, "Quinta"), (5, "Sexta"), (6, "Sábado"), (0, "Domingo")
                                };
                                var hojeDow = (int)Model.AgoraSaoPaulo.DayOfWeek;
                            }
                            @foreach (var d in nomesDias)
                            {
                                <label class="day-chip">
                                    <input type="checkbox"
                                           name="diasSemanaPost"
                                           value="@d.Valor"
                                           @(d.Valor == hojeDow ? "checked" : null) />
                                    <span>@d.Nome</span>
                                </label>
                            }
                        </div>
                        <small>Se marcar mais de um dia (ex.: Segunda, Quarta e Sexta), o sistema agenda automaticamente para cada um desses dias.</small>
                    </div>

                    <div class="field" style="margin-top:14px;">
                        <label for="postLegenda">Legenda da publicação no Instagram (máx. 2.200 caracteres)</label>
                        <textarea id="postLegenda"
                                  name="legenda"
                                  rows="4"
                                  maxlength="2200"
                                  placeholder="Escreva a legenda com emojis, chamada e hashtags..."></textarea>
                    </div>

                    <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:14px;flex-wrap:wrap;">
                        <label style="display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer;">
                            <input type="checkbox" name="publicarImediatamente" value="true" />
                            Publicar imediatamente no Instagram após salvar
                        </label>

                        <button type="submit" class="btn btn-primary" style="min-height:42px;padding:10px 20px;">
                            Confirmar e Agendar Publicação
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </section>

    <!-- 2. CRIAR E PROGRAMAR STORY AUTOMÁTICO RECORRENTE (FOTO OU VÍDEO 9:16) -->
    <section class="dash-section">
        <h2 class="dash-section-title">2. Programar Story Automático (Foto ou Vídeo 9:16 do Celular/PC)</h2>
        <p class="dash-section-desc">
            Suba sua arte vertical pronta (Foto JPG/PNG ou Vídeo MP4/MOV) e programe para o sistema postar automaticamente todo dia nos horários escolhidos ou em uma data única.
        </p>

        <form method="post"
              asp-page-handler="CriarStoryRecorrente"
              enctype="multipart/form-data"
              style="padding:16px;background:var(--panel-alt);border:1px solid var(--border);border-radius:12px;margin-bottom:18px;">
            @Html.AntiForgeryToken()

            <div class="split-layout">
                <div class="preview-col">
                    <div style="width:136px;height:240px;background:#0d0b14;border:1px dashed #473869;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:8px;text-align:center;color:var(--muted);font-size:11px;">
                        <img id="storyPreviewImg" alt="Prévia Story" style="display:none;width:100%;height:100%;object-fit:cover;" />
                        <video id="storyPreviewVideo" controls muted playsinline style="display:none;width:100%;height:100%;object-fit:cover;"></video>
                        <span id="storyPreviewText">Prévia Vertical 9:16 (Foto ou Vídeo)</span>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="field">
                        <label for="storyContaIg">Para qual Instagram é este Story?</label>
                        <select id="storyContaIg" name="instagramContaId" required>
                            @foreach (var conta in Model.ContasDisponiveis)
                            {
                                <option value="@conta.Id" selected="@(Model.ContaSelecionada?.Id == conta.Id ? "selected" : null)">
                                    @conta.IdentificadorInstagram — @conta.NomeCadastro
                                </option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="storyTitulo">Nome de identificação do Story</label>
                        <input id="storyTitulo"
                               name="titulo"
                               type="text"
                               value="Story Chamada / Link na Bio"
                               required />
                    </div>

                    <div class="field">
                        <label for="storyImagemInput">Foto ou Vídeo vertical do celular ou PC</label>
                        <input id="storyImagemInput"
                               name="imagemStory"
                               type="file"
                               accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime"
                               required />
                        <small>Foto (JPG/PNG) ou Vídeo (MP4/MOV até 55 MB).</small>
                    </div>

                    <div class="field">
                        <label for="storyModo">Frequência de publicação</label>
                        <select id="storyModo" name="modoAgendamento">
                            <option value="@ModoStoryRecorrente.RecorrenteDiario" selected>
                                Recorrente nos dias da semana e horários escolhidos
                            </option>
                            <option value="@ModoStoryRecorrente.UnicaVez">
                                Apenas uma vez na data e hora escolhida
                            </option>
                        </select>
                    </div>

                    <div class="field" id="campoHorariosStory">
                        <label for="storyHorarios">Horários do Story (HH:mm)</label>
                        <input id="storyHorarios"
                               name="horariosDiarios"
                               type="text"
                               value="10:00, 19:00"
                               placeholder="10:00, 15:00, 20:00" />
                    </div>

                    <div class="field" id="campoDiasSemanaStory" style="grid-column:1 / -1;">
                        <label>Em quais Dias da Semana este Story deve ser postado?</label>
                        <div class="days-grid">
                            @foreach (var d in new (int Valor, string Nome)[] { (1, "Seg"), (2, "Ter"), (3, "Qua"), (4, "Qui"), (5, "Sex"), (6, "Sáb"), (0, "Dom") })
                            {
                                <label class="day-chip">
                                    <input type="checkbox" name="diasSemana" value="@d.Valor" checked />
                                    <span>@d.Nome</span>
                                </label>
                            }
                        </div>
                        <small>Deixe todos marcados para postar todos os dias, ou marque apenas os dias da semana desejados.</small>
                    </div>

                    <div class="field" id="campoDataUnicaStory" style="display:none;">
                        <label for="storyDataUnica">Data e hora única (America/Sao_Paulo)</label>
                        <input id="storyDataUnica"
                               name="dataHoraUnicaLocal"
                               type="datetime-local"
                               value="@Model.AgoraSaoPaulo.AddHours(1).ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture)" />
                    </div>

                    <div class="field" style="justify-content:flex-end;">
                        <button type="submit" class="btn btn-primary" style="min-height:42px;">
                            Salvar e Programar Story
                        </button>
                    </div>
                </div>
            </div>
        </form>

        @if (Model.StoriesRecorrentes.Count > 0)
        {
            <div class="queue-list">
                @foreach (var story in Model.StoriesRecorrentes)
                {
                    var horariosTexto = Model.ObterHorariosStoryTexto(story);
                    var diasStory = InstagramAgendadorService.DeserializarDiasSemana(story.DiasSemanaJson);
                    var resumoDiasStory = InstagramAgendadorService.FormatarDiasSemanaResumo(story.DiasSemanaJson);
                    <div class="queue-item" id="story-card-@story.Id">
                        <div>
                            @if (story.EhVideo)
                            {
                                <video src="/media/story/@(story.Id).mp4?v=@(story.CriadoEmUtc.UtcTicks)"
                                       controls
                                       muted
                                       playsinline
                                       style="width:96px;height:170px;object-fit:cover;border-radius:9px;border:1px solid var(--border);background:#0d0b14;"></video>
                            }
                            else
                            {
                                <img src="/media/story/@(story.Id).jpg?v=@(story.CriadoEmUtc.UtcTicks)"
                                     alt="@story.Titulo"
                                     style="width:96px;height:170px;object-fit:cover;border-radius:9px;border:1px solid var(--border);"
                                     loading="lazy" />
                            }
                        </div>

                        <div>
                            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:8px;">
                                <div>
                                    <strong style="font-size:14px;color:#fff;">Story #@story.Id — @story.Titulo</strong>
                                    <span class="pill agendado" style="margin-left:8px;">@story.IdentificadorInstagram</span>
                                    <span class="pill cancelado" style="margin-left:4px;">📅 @resumoDiasStory</span>
                                    <div style="font-size:11.5px;color:var(--muted);margin-top:4px;">
                                        Próximo disparo: <strong style="color:#fff;">@story.ProximoDisparoLocal.ToString("ddd, dd/MM/yyyy 'às' HH:mm", cultura)</strong>
                                        · Total enviado: <strong>@story.TotalPublicacoes vez(es)</strong>
                                    </div>
                                </div>

                                <span class="pill @(story.Ativo ? "publicado" : "cancelado")">
                                    @(story.Ativo ? "Automático Ativo" : story.Status)
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(story.UltimoErro))
                            {
                                <div style="margin-bottom:10px;padding:8px 11px;background:#3b1c26;border:1px solid #7b3248;border-radius:7px;color:#ffb4b4;font-size:11.5px;">
                                    <strong>Erro:</strong> @story.UltimoErro
                                </div>
                            }

                            <form method="post" asp-page-handler="EditarStoryRecorrente" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="storyId" value="@story.Id" />

                                <div class="form-grid">
                                    <div class="field">
                                        <label>Instagram</label>
                                        <select name="instagramContaId">
                                            @foreach (var c in Model.ContasDisponiveis)
                                            {
                                                <option value="@c.Id" selected="@(story.InstagramContaId == c.Id ? "selected" : null)">
                                                    @c.IdentificadorInstagram
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label>Título</label>
                                        <input type="text" name="titulo" value="@story.Titulo" required />
                                    </div>
                                    <div class="field">
                                        <label>Modo</label>
                                        <select name="modoAgendamento">
                                            <option value="@ModoStoryRecorrente.RecorrenteDiario"
                                                    selected="@(story.ModoAgendamento == ModoStoryRecorrente.RecorrenteDiario ? "selected" : null)">
                                                Todo dia nos horários
                                            </option>
                                            <option value="@ModoStoryRecorrente.UnicaVez"
                                                    selected="@(story.ModoAgendamento == ModoStoryRecorrente.UnicaVez ? "selected" : null)">
                                                Única vez
                                            </option>
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label>Horários (HH:mm)</label>
                                        <input type="text" name="horariosDiarios" value="@horariosTexto" />
                                    </div>
                                    <div class="field">
                                        <label>Data/Hora Única</label>
                                        <input type="datetime-local"
                                               name="dataHoraUnicaLocal"
                                               value="@((story.DataHoraUnicaLocal ?? story.ProximoDisparoLocal).ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture))" />
                                    </div>
                                    <div class="field">
                                        <label>Trocar foto/vídeo (opcional)</label>
                                        <input type="file" name="novaImagemStory" accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime" />
                                    </div>
                                    <div class="field" style="grid-column:1 / -1;">
                                        <label>Dias da Semana deste Story</label>
                                        <div class="days-grid">
                                            @foreach (var d in new (int Valor, string Nome)[] { (1, "Seg"), (2, "Ter"), (3, "Qua"), (4, "Qui"), (5, "Sex"), (6, "Sáb"), (0, "Dom") })
                                            {
                                                <label class="day-chip">
                                                    <input type="checkbox"
                                                           name="diasSemana"
                                                           value="@d.Valor"
                                                           @(diasStory.Contains(d.Valor) ? "checked" : null) />
                                                    <span>@d.Nome</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
                                    <button type="submit" class="btn btn-secondary">Salvar Alterações</button>
                                </div>
                            </form>

                            <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
                                <form method="post" asp-page-handler="PublicarStoryAgora" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storyId" value="@story.Id" />
                                    <button type="submit" class="btn btn-primary">Publicar este Story agora</button>
                                </form>

                                <form method="post" asp-page-handler="AlternarStoryAtivo" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storyId" value="@story.Id" />
                                    <button type="submit" class="btn btn-secondary">
                                        @(story.Ativo ? "Pausar" : "Ativar")
                                    </button>
                                </form>

                                <form method="post"
                                      asp-page-handler="ExcluirStory"
                                      style="margin:0;"
                                      onsubmit="return confirm('Deseja excluir este Story programado?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storyId" value="@story.Id" />
                                    <button type="submit" class="btn btn-danger">Excluir</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- 3. FILA DE POSTS AGENDADOS E HISTÓRICO -->
    <section class="dash-section">
        <h2 class="dash-section-title">3. Fila de Agendamentos e Histórico de Publicações</h2>
        <p class="dash-section-desc">
            Acompanhe, edite a legenda ou horário, publique imediatamente ou cancele qualquer postagem agendada.
        </p>

        @if (Model.PostsAgendados.Count == 0)
        {
            <div style="padding:28px;text-align:center;color:var(--muted);">
                Nenhuma publicação agendada na fila para este Instagram.
            </div>
        }
        else
        {
            <div class="queue-list">
                @foreach (var post in Model.PostsAgendados)
                {
                    var pillClass = post.Status switch
                    {
                        StatusPostInstagram.Publicado => "publicado",
                        StatusPostInstagram.Falha => "falha",
                        StatusPostInstagram.Cancelado => "cancelado",
                        _ => "agendado"
                    };

                    var extMidiaPost = post.EhVideo ? "mp4" : "jpg";
                    var imgSrc = !string.IsNullOrWhiteSpace(post.UrlImagemExterna)
                        ? post.UrlImagemExterna
                        : $"/media/post/{post.Id}.{extMidiaPost}?v={post.CriadoEmUtc.UtcTicks}";

                    <div class="queue-item" id="post-card-@post.Id">
                        <div>
                            @if (post.EhVideo)
                            {
                                <video src="@imgSrc"
                                       controls
                                       muted
                                       playsinline
                                       style="width:98px;height:98px;object-fit:cover;border-radius:9px;border:1px solid var(--border);background:#0d0b14;"></video>
                            }
                            else
                            {
                                <img src="@imgSrc"
                                     alt="@post.Titulo"
                                     style="width:98px;height:98px;object-fit:cover;border-radius:9px;border:1px solid var(--border);background:#0d0b14;"
                                     loading="lazy" />
                            }
                        </div>

                        <div>
                            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:8px;">
                                <div>
                                    <strong style="font-size:14px;color:#fff;">#@post.Id — @post.Titulo</strong>
                                    <span class="pill agendado" style="margin-left:8px;">@post.IdentificadorInstagram</span>
                                    <span class="pill cancelado" style="margin-left:4px;">
                                        @(post.EhCarrossel ? "📸 Carrossel no Feed" : post.EhVideo ? $"🎬 Vídeo ({post.TipoPublicacao})" : post.TipoPublicacao)
                                    </span>
                                    @if (post.RecorrenteSemanal)
                                    {
                                        <span class="pill publicado" style="margin-left:4px;">
                                            🔁 Toda semana: @InstagramAgendadorService.FormatarDiasSemanaResumo(post.DiasSemanaJson) às @(post.HorarioFixoSemanal ?? post.HorarioProgramadoLocal.ToString("HH:mm"))
                                        </span>
                                    }
                                    <div style="font-size:11.5px;color:var(--muted);margin-top:4px;">
                                        Programado para: <strong style="color:#fff;">@post.HorarioProgramadoLocal.ToString("dd/MM/yyyy 'às' HH:mm", cultura)</strong>
                                        @if (!string.IsNullOrWhiteSpace(post.MediaIdMeta))
                                        {
                                            <span> · Media ID Meta: <code>@post.MediaIdMeta</code></span>
                                        }
                                    </div>
                                </div>

                                <span class="pill @pillClass">@post.Status</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(post.UltimoErro))
                            {
                                <div style="margin-bottom:10px;padding:8px 11px;background:#3b1c26;border:1px solid #7b3248;border-radius:7px;color:#ffb4b4;font-size:11.5px;">
                                    <strong>Erro:</strong> @post.UltimoErro (Tentativas: @post.Tentativas)
                                </div>
                            }

                            @if (post.Status != StatusPostInstagram.Publicado)
                            {
                                <form method="post" asp-page-handler="EditarPostAgendado" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@post.Id" />

                                    <div class="form-grid">
                                        <div class="field">
                                            <label>Instagram</label>
                                            <select name="instagramContaId">
                                                @foreach (var c in Model.ContasDisponiveis)
                                                {
                                                    <option value="@c.Id" selected="@(post.InstagramContaId == c.Id ? "selected" : null)">
                                                        @c.IdentificadorInstagram
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="field">
                                            <label>Título</label>
                                            <input type="text" name="titulo" value="@post.Titulo" required />
                                        </div>

                                        <div class="field">
                                            <label>Data e horário (America/Sao_Paulo)</label>
                                            <input type="datetime-local"
                                                   name="horarioProgramadoLocal"
                                                   value="@post.HorarioProgramadoLocal.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture)"
                                                   required />
                                        </div>

                                        <div class="field">
                                            <label>Onde publicar</label>
                                            <select name="tipoPublicacao">
                                                <option value="@TipoMidiaInstagram.Feed" selected="@(post.TipoPublicacao == TipoMidiaInstagram.Feed ? "selected" : null)">Feed</option>
                                                <option value="@TipoMidiaInstagram.FeedCarrossel" selected="@(post.TipoPublicacao == TipoMidiaInstagram.FeedCarrossel ? "selected" : null)">Carrossel no Feed</option>
                                                <option value="@TipoMidiaInstagram.FeedEStories" selected="@(post.TipoPublicacao == TipoMidiaInstagram.FeedEStories ? "selected" : null)">Feed + Stories</option>
                                                <option value="@TipoMidiaInstagram.Stories" selected="@(post.TipoPublicacao == TipoMidiaInstagram.Stories ? "selected" : null)">Somente Stories</option>
                                            </select>
                                        </div>

                                        <div class="field">
                                            <label>Trocar foto/vídeo (opcional)</label>
                                            <input type="file" name="novaImagem" accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime" />
                                        </div>
                                    </div>

                                    <div class="field" style="margin-top:10px;">
                                        <label>Legenda</label>
                                        <textarea name="legenda" rows="3" maxlength="2200">@post.Legenda</textarea>
                                    </div>

                                    <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
                                        <button type="submit" class="btn btn-secondary">
                                            Salvar Alterações @(post.Status != StatusPostInstagram.Agendado ? "(Reativar)" : "")
                                        </button>
                                    </div>
                                </form>

                                <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
                                    <form method="post" asp-page-handler="PublicarPostAgora" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@post.Id" />
                                        <button type="submit" class="btn btn-primary">Publicar Agora</button>
                                    </form>

                                    @if (post.Status != StatusPostInstagram.Cancelado)
                                    {
                                        <form method="post" asp-page-handler="CancelarPost" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="postId" value="@post.Id" />
                                            <button type="submit" class="btn btn-secondary">Cancelar</button>
                                        </form>
                                    }

                                    <form method="post"
                                          asp-page-handler="ExcluirPost"
                                          style="margin:0;"
                                          onsubmit="return confirm('Deseja excluir este agendamento?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@post.Id" />
                                        <button type="submit" class="btn btn-danger">Excluir</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <details style="margin-top:8px;font-size:12px;color:var(--muted);">
                                    <summary style="cursor:pointer;">Ver legenda publicada</summary>
                                    <pre style="white-space:pre-wrap;background:#0d0b14;padding:10px;border-radius:7px;color:#eadff7;margin-top:6px;">@post.Legenda</pre>
                                </details>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

<script>
    (() => {
        const postModoHorario = document.getElementById("postModoHorario");
        const campoHorarioManualPost = document.getElementById("campoHorarioManualPost");
        const campoHorarioDiaSemanaPost = document.getElementById("campoHorarioDiaSemanaPost");
        const blocoDiasSemanaPost = document.getElementById("blocoDiasSemanaPost");
        if (postModoHorario) {
            const togglePostHorario = () => {
                const val = postModoHorario.value;
                if (campoHorarioManualPost) campoHorarioManualPost.style.display = val === "manual" ? "flex" : "none";
                if (campoHorarioDiaSemanaPost) campoHorarioDiaSemanaPost.style.display = val === "dias_semana" ? "flex" : "none";
                if (blocoDiasSemanaPost) blocoDiasSemanaPost.style.display = val === "dias_semana" ? "flex" : "none";
            };
            postModoHorario.addEventListener("change", togglePostHorario);
            togglePostHorario();
        }

        const postArquivo = document.getElementById("postArquivo");
        const postPreviewImg = document.getElementById("postPreviewImg");
        const postPreviewVideo = document.getElementById("postPreviewVideo");
        const postPreviewText = document.getElementById("postPreviewText");
        const postPreviewCaption = document.getElementById("postPreviewCaption");
        const postTipo = document.getElementById("postTipo");

        if (postArquivo && postPreviewImg && postPreviewText) {
            postArquivo.addEventListener("change", () => {
                const files = postArquivo.files ? Array.from(postArquivo.files) : [];
                if (files.length === 0) {
                    postPreviewImg.style.display = "none";
                    if (postPreviewVideo) postPreviewVideo.style.display = "none";
                    postPreviewText.style.display = "inline";
                    if (postPreviewCaption) postPreviewCaption.textContent = "Foto (JPG/PNG) ou Vídeo (MP4/MOV até 55 MB)";
                    return;
                }

                if (files.length >= 2 && postTipo) {
                    postTipo.value = "@TipoMidiaInstagram.FeedCarrossel";
                }

                const f = files[0];
                const ehVid = f.type && f.type.startsWith("video/");
                const urlObj = URL.createObjectURL(f);

                if (ehVid && postPreviewVideo) {
                    postPreviewImg.style.display = "none";
                    postPreviewVideo.src = urlObj;
                    postPreviewVideo.style.display = "block";
                    postPreviewText.style.display = "none";
                } else {
                    if (postPreviewVideo) postPreviewVideo.style.display = "none";
                    postPreviewImg.src = urlObj;
                    postPreviewImg.style.display = "block";
                    postPreviewText.style.display = "none";
                }

                if (postPreviewCaption) {
                    postPreviewCaption.textContent = files.length >= 2
                        ? `📸 Carrossel: ${files.length} arquivos selecionados`
                        : ehVid
                            ? "🎬 1 Vídeo selecionado"
                            : "🖼 1 Foto selecionada";
                }
            });
        }

        const storyImagemInput = document.getElementById("storyImagemInput");
        const storyPreviewImg = document.getElementById("storyPreviewImg");
        const storyPreviewVideo = document.getElementById("storyPreviewVideo");
        const storyPreviewText = document.getElementById("storyPreviewText");
        if (storyImagemInput && storyPreviewImg && storyPreviewText) {
            storyImagemInput.addEventListener("change", () => {
                const f = storyImagemInput.files && storyImagemInput.files[0];
                if (!f) {
                    storyPreviewImg.style.display = "none";
                    if (storyPreviewVideo) storyPreviewVideo.style.display = "none";
                    storyPreviewText.style.display = "inline";
                    return;
                }
                const ehVid = f.type && f.type.startsWith("video/");
                const urlObj = URL.createObjectURL(f);
                if (ehVid && storyPreviewVideo) {
                    storyPreviewImg.style.display = "none";
                    storyPreviewVideo.src = urlObj;
                    storyPreviewVideo.style.display = "block";
                    storyPreviewText.style.display = "none";
                } else {
                    if (storyPreviewVideo) storyPreviewVideo.style.display = "none";
                    storyPreviewImg.src = urlObj;
                    storyPreviewImg.style.display = "block";
                    storyPreviewText.style.display = "none";
                }
            });
        }

        const storyModo = document.getElementById("storyModo");
        const campoHorariosStory = document.getElementById("campoHorariosStory");
        const campoDiasSemanaStory = document.getElementById("campoDiasSemanaStory");
        const campoDataUnicaStory = document.getElementById("campoDataUnicaStory");
        if (storyModo && campoHorariosStory && campoDataUnicaStory) {
            const toggleStoryModo = () => {
                const unica = storyModo.value === "@ModoStoryRecorrente.UnicaVez";
                campoHorariosStory.style.display = unica ? "none" : "flex";
                if (campoDiasSemanaStory) campoDiasSemanaStory.style.display = unica ? "none" : "flex";
                campoDataUnicaStory.style.display = unica ? "flex" : "none";
            };
            storyModo.addEventListener("change", toggleStoryModo);
            toggleStoryModo();
        }
    })();
</script>
