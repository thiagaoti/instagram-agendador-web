@page
@model InstagramAgendador.Web.Pages.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Central de Agendamento Instagram";
    var cultura = CultureInfo.GetCultureInfo("pt-BR");
    var proximoSlotPadrao = Model.ProximosSlotsConta.Count > 0
        ? Model.ProximosSlotsConta[0]
        : Model.AgoraSaoPaulo.AddHours(1);
}

<style>
    .dash-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .dash-eyebrow {
        color: var(--accent);
        font-size: 11px;
        font-weight: 850;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .dash-title {
        margin: 0;
        font-size: clamp(25px, 3.8vw, 34px);
        font-weight: 900;
    }

    .dash-sub {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 13px;
        max-width: 780px;
        line-height: 1.6;
    }

    .account-switcher {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
        flex-wrap: wrap;
        max-width: 100%;
        min-width: 0;
    }

    .account-switcher select {
        padding: 8px 12px;
        background: var(--panel-alt);
        color: #fff;
        border: 1px solid #453668;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 800;
        max-width: 100%;
        min-width: 0;
    }

    .dash-alert {
        padding: 13px 16px;
        margin-bottom: 18px;
        border-radius: 10px;
        background: #153224;
        border: 1px solid #285c40;
        color: #9af0b9;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .dash-alert.erro {
        background: #3b1c26;
        border-color: #7b3248;
        color: #ffb4b4;
    }

    .dash-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 155px), 1fr));
        gap: 12px;
        margin-bottom: 24px;
        min-width: 0;
    }

    .metric-box {
        padding: 15px 17px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 11px;
        min-width: 0;
        overflow: hidden;
    }

    .metric-label {
        font-size: 11px;
        font-weight: 750;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .metric-val {
        margin-top: 6px;
        font-size: 24px;
        font-weight: 900;
        color: #fff;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .metric-val.pink { color: var(--accent); }
    .metric-val.green { color: var(--success); }
    .metric-val.warn { color: var(--warn); font-size: 16px; margin-top: 10px; }

    .dash-section {
        padding: 22px;
        margin-bottom: 24px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
    }

    .dash-section.studio-highlight {
        background: linear-gradient(160deg, #1b1530 0%, #141224 100%);
        border: 1px solid #4c3575;
        box-shadow: 0 14px 40px #0000004d;
    }

    .dash-section-title {
        margin: 0 0 4px;
        font-size: 18px;
        font-weight: 850;
    }

    .dash-section-desc {
        margin: 0 0 18px;
        color: var(--muted);
        font-size: 12.5px;
        line-height: 1.5;
    }

    .split-layout {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr);
        gap: 18px;
        align-items: start;
        min-width: 0;
        max-width: 100%;
    }

    .split-layout-studio {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 20px;
        align-items: start;
        min-width: 0;
        max-width: 100%;
    }

    .preview-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        min-width: 0;
        max-width: 100%;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 215px), 1fr));
        gap: 14px;
        min-width: 0;
        max-width: 100%;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        max-width: 100%;
    }

    .field label {
        font-size: 11.5px;
        font-weight: 750;
        color: #e2d7f0;
    }

    .field input,
    .field select,
    .field textarea {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        padding: 9px 11px;
        background: var(--panel-alt);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font-size: 12.5px;
    }

    .field small {
        font-size: 10.5px;
        color: var(--muted);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 38px;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        border: 1px solid transparent;
        text-decoration: none;
        max-width: 100%;
        text-align: center;
    }

    .btn-primary {
        background: linear-gradient(90deg, #ff4f8b, #ff7a59);
        color: #16050c;
    }

    .btn-ai {
        background: linear-gradient(90deg, #06b6d4, #6366f1, #a855f7);
        color: #ffffff;
        box-shadow: 0 6px 20px #6366f144;
    }

    .btn-secondary {
        background: #231c35;
        border-color: #3d315b;
        color: #eadff7;
    }

    .btn-danger {
        background: #381924;
        border-color: #6e2b42;
        color: #ffb4b4;
    }

    .queue-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-width: 0;
    }

    .queue-item {
        display: grid;
        grid-template-columns: 105px minmax(0, 1fr);
        gap: 16px;
        padding: 16px;
        background: var(--panel-alt);
        border: 1px solid var(--border);
        border-radius: 12px;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
    }

    .queue-item > div {
        min-width: 0;
        max-width: 100%;
    }

    .pill {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 850;
        text-transform: uppercase;
    }

    .pill.agendado { background: #14283b; color: #72d2ff; border: 1px solid #204c73; }
    .pill.publicado { background: #153224; color: #9af0b9; border: 1px solid #285c40; }
    .pill.falha { background: #3b1c26; color: #ffb4b4; border: 1px solid #7b3248; }
    .pill.cancelado { background: #211d29; color: #9d91b0; border: 1px solid #352e42; }

    @@media (max-width: 780px) {
        .split-layout,
        .split-layout-studio,
        .queue-item {
            grid-template-columns: 1fr;
        }

        .dash-section {
            padding: 15px 12px;
            border-radius: 12px;
        }

        .queue-item {
            padding: 13px 11px;
        }

        .account-switcher {
            width: 100%;
            padding: 10px 12px;
        }

        .account-switcher form {
            width: 100%;
        }

        .account-switcher select {
            width: 100%;
        }
    }
</style>

<div class="dash-header">
    <div>
        <div class="dash-eyebrow">SISTEMA EXCLUSIVO DE AGENDAMENTO INSTAGRAM</div>
        <h1 class="dash-title">Central de Publicações (Feed & Stories)</h1>
        <p class="dash-sub">
            Escolha para qual Instagram deseja agendar, suba a foto ou arte do seu celular/PC, personalize a legenda e programe o disparo automático.
        </p>
    </div>

    <div class="account-switcher">
        <form method="get" style="display:flex;align-items:center;gap:10px;margin:0;flex-wrap:wrap;">
            <label for="seletorContaTopo" style="font-size:12px;font-weight:800;color:#e2d7f0;">
                Instagram Ativo:
            </label>
            <select id="seletorContaTopo" name="ContaId" onchange="this.form.submit()">
                @if (Model.ContasDisponiveis.Count == 0)
                {
                    <option value="">Nenhum Instagram cadastrado</option>
                }
                else
                {
                    @foreach (var c in Model.ContasDisponiveis)
                    {
                        <option value="@c.Id" selected="@(Model.ContaSelecionada?.Id == c.Id ? "selected" : null)">
                            @c.IdentificadorInstagram (@c.NomeCadastro)
                        </option>
                    }
                }
            </select>
        </form>
        @if (Model.EhAdmin)
        {
            <a href="/Configuracoes" class="btn btn-secondary">
                ⚙ Incluir Perfis / Usuários (Admin)
            </a>
        }
    </div>
</div>

@if (TempData["Mensagem"] is string mensagem)
{
    <div class="dash-alert @(TempData["TipoMensagem"]?.ToString() == "erro" ? "erro" : "")" role="status">
        @mensagem
    </div>
}

@if (Model.ContasDisponiveis.Count == 0)
{
    <section class="dash-section" style="text-align:center;padding:38px 24px;">
        @if (Model.EhAdmin)
        {
            <h2 style="margin:0 0 10px;font-size:22px;">Inclua o primeiro Perfil do Instagram para começar!</h2>
            <p style="color:var(--muted);max-width:560px;margin:0 auto 20px;font-size:13.5px;line-height:1.6;">
                Como Administrador, acesse a tela de Configurações para cadastrar os usuários e incluir o perfil do Instagram (@@perfil, Account ID e Access Token) com a respectiva configuração de cada usuário.
            </p>
            <a href="/Configuracoes" class="btn btn-primary" style="padding:12px 22px;font-size:13px;">
                Ir para Tela de Configuração (Admin) →
            </a>
        }
        else
        {
            <h2 style="margin:0 0 10px;font-size:22px;">Aguardando liberação do seu Perfil do Instagram</h2>
            <p style="color:var(--muted);max-width:560px;margin:0 auto;font-size:13.5px;line-height:1.6;">
                O seu usuário ainda não possui um perfil do Instagram vinculado. Solicite ao <strong>Administrador</strong> que inclua o seu Instagram e a respectiva configuração na tela administrativa.
            </p>
        }
    </section>
}
else
{
    <section class="dash-metrics">
        <div class="metric-box">
            <div class="metric-label">Instagram Selecionado</div>
            <div class="metric-val pink" style="font-size:18px;margin-top:9px;">
                @(Model.ContaSelecionada?.IdentificadorInstagram ?? "--")
            </div>
        </div>
        <div class="metric-box">
            <div class="metric-label">Posts na Fila</div>
            <div class="metric-val">@Model.TotalPostsNaFila</div>
        </div>
        <div class="metric-box">
            <div class="metric-label">Stories Automáticos Ativos</div>
            <div class="metric-val green">@Model.TotalStoriesAtivos</div>
        </div>
        <div class="metric-box">
            <div class="metric-label">Total Publicados</div>
            <div class="metric-val">@Model.TotalPublicados</div>
        </div>
        <div class="metric-box">
            <div class="metric-label">Próximo Horário Livre</div>
            <div class="metric-val warn">
                @proximoSlotPadrao.ToString("dd/MM 'às' HH:mm", cultura)
            </div>
        </div>
    </section>

    <!-- ESTÚDIO IA: CRIAR IMAGEM DIRETO POR PROMPT E JÁ AGENDAR -->
    <section class="dash-section studio-highlight">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:6px;">
            <span class="pill agendado" style="background:#1c2548;border-color:#4458a8;color:#93c5fd;">
                ✨ GERADOR DE IMAGEM IA DIRETO POR PROMPT (FLUX AI / DALL-E 3)
            </span>
        </div>
        <h2 class="dash-section-title">Criar Imagem via Prompt de IA & Já Agendar</h2>
        <p class="dash-section-desc">
            Digite livremente o seu prompt descrevendo a imagem que deseja criar. A IA gera a foto na hora, monta a arte (com ou sem texto sobreposto) e já agenda para o seu Instagram!
        </p>

        <form method="post"
              asp-page-handler="GerarImagemEAgendar"
              id="formEstudioPrompt">
            @Html.AntiForgeryToken()
            <input type="hidden" name="imagemCompostaBase64" id="studioImagemCompostaBase64" />

            <div class="split-layout-studio">
                <div class="preview-col">
                    <div style="width:100%;max-width:225px;background:#0a0910;border:1px solid #443568;border-radius:12px;padding:8px;display:flex;flex-direction:column;align-items:center;gap:6px;">
                        <canvas id="studioCanvasPreview"
                                width="1080"
                                height="1080"
                                style="width:100%;height:auto;border-radius:8px;background:#120f1d;display:block;"></canvas>
                        <small id="studioStatusLabel" style="color:#b9ace0;font-size:10.5px;text-align:center;">
                            Prévia ao vivo da Arte (1080x1080)
                        </small>
                    </div>

                    <button type="button"
                            id="btnGerarPreviaPrompt"
                            class="btn btn-ai"
                            style="width:100%;max-width:225px;min-height:40px;">
                        🎨 Gerar Imagem pelo Prompt
                    </button>
                </div>

                <div style="min-width:0;max-width:100%;">
                    <div class="form-grid">
                        <div class="field">
                            <label for="studioContaIg">Para qual Instagram?</label>
                            <select id="studioContaIg" name="instagramContaId" required>
                                @foreach (var conta in Model.ContasDisponiveis)
                                {
                                    <option value="@conta.Id"
                                            data-arroba="@conta.IdentificadorInstagram"
                                            selected="@(Model.ContaSelecionada?.Id == conta.Id ? "selected" : null)">
                                        @conta.IdentificadorInstagram — @conta.NomeCadastro
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="field">
                            <label for="studioModeloIa">Motor de IA Gerador da Imagem</label>
                            <select id="studioModeloIa" name="modeloIa">
                                <option value="flux" selected>⚡ Flux AI (Gratuito · Sem Chave API)</option>
                                <option value="flux-realism">📸 Flux Realism (Fotorealista · Gratuito)</option>
                                <option value="gemini">✨ Google Gemini Imagen 3 (Chave AIza...)</option>
                                <option value="dalle3">🤖 OpenAI DALL-E 3 (Chave sk-...)</option>
                            </select>
                        </div>

                        <div class="field">
                            <label for="studioFormato">Onde publicar / Formato da Imagem</label>
                            <select id="studioFormato" name="formatoDestino">
                                <option value="Feed">Feed Quadrado (1080x1080)</option>
                                <option value="Stories">Story Vertical Único (1080x1920)</option>
                                <option value="FeedEStories">Feed + Stories Juntos</option>
                                <option value="StoryRecorrente">Story Automático Todo Dia (9:16)</option>
                            </select>
                        </div>

                        <div class="field">
                            <label for="studioEstiloArte">Acabamento da Imagem</label>
                            <select id="studioEstiloArte">
                                <option value="poster" selected>Poster Comercial Completo (Foto IA + Textos do Prompt)</option>
                                <option value="limpo">Somente a Imagem Gerada pela IA (Sem Textos)</option>
                                <option value="completo">Imagem IA + Moldura Simples (Selo e Título)</option>
                            </select>
                        </div>
                    </div>

                    <div class="field" style="margin-top:12px;">
                        <label for="studioPrompt">Cole ou digite o seu Prompt completo (em português ou inglês)</label>
                        <textarea id="studioPrompt"
                                  name="promptCriacao"
                                  rows="5"
                                  placeholder="Cole aqui o seu prompt detalhado (ex.: Create a premium, high-impact vertical promotional poster 9:16 for SCOOTER ACHADINHOS...)"
                                  required></textarea>
                        <small>Suporta prompts longos e estruturados! O sistema gera a foto real do veículo/produto via IA e monta os textos em português com nitidez.</small>
                    </div>

                    <div class="field" style="margin-top:10px;">
                        <label for="studioApiKey">Chave API Opcional (Google Gemini `AIza...` ou OpenAI `sk-...` — deixe vazio para usar o Flux Gratuito)</label>
                        <input id="studioApiKey"
                               name="apiKeyManual"
                               type="password"
                               placeholder="Opcional: cole sua chave Gemini ou OpenAI se quiser usar Imagen 3 / DALL-E 3" />
                    </div>

                    <div class="form-grid" style="margin-top:12px;">
                        <div class="field">
                            <label for="studioSelo">Selo de Topo na Arte (opcional)</label>
                            <input id="studioSelo"
                                   name="seloTopo"
                                   type="text"
                                   value="🔥 DESTAQUE DO DIA"
                                   placeholder="Ex.: 🔥 OFERTA IMPERDÍVEL" />
                        </div>

                        <div class="field">
                            <label for="studioTituloArte">Título Principal na Imagem (opcional)</label>
                            <input id="studioTituloArte"
                                   name="tituloArte"
                                   type="text"
                                   placeholder="Gerado automaticamente pelo prompt se vazio" />
                        </div>

                        <div class="field">
                            <label for="studioSubtituloArte">Chamada / Rodapé na Arte (opcional)</label>
                            <input id="studioSubtituloArte"
                                   name="subtituloArte"
                                   type="text"
                                   value="Confira os detalhes · Link na Bio!"
                                   placeholder="Ex.: Link na Bio · Aproveite hoje!" />
                        </div>

                        <div class="field" id="studioBlocoModoHorario">
                            <label for="studioModoHorario">Quando postar?</label>
                            <select id="studioModoHorario" name="modoHorario">
                                <option value="auto" selected>
                                    Próximo horário livre (@proximoSlotPadrao.ToString("dd/MM HH:mm"))
                                </option>
                                <option value="manual">Escolher data e hora específica</option>
                            </select>
                        </div>

                        <div class="field" id="studioCampoHorarioManual" style="display:none;">
                            <label for="studioHorarioManual">Data e hora (America/Sao_Paulo)</label>
                            <input id="studioHorarioManual"
                                   name="horarioEspecificoLocal"
                                   type="datetime-local"
                                   value="@proximoSlotPadrao.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture)" />
                        </div>

                        <div class="field" id="studioCampoHorariosStory" style="display:none;">
                            <label for="studioHorariosStory">Horários diários do Story (HH:mm)</label>
                            <input id="studioHorariosStory"
                                   name="horariosDiariosStory"
                                   type="text"
                                   value="10:00, 19:00"
                                   placeholder="10:00, 19:00" />
                        </div>
                    </div>

                    <div class="field" style="margin-top:12px;">
                        <label for="studioLegenda">Legenda do Post (gerada automaticamente pelo nicho ou edite como quiser)</label>
                        <textarea id="studioLegenda"
                                  name="legendaCustomizada"
                                  rows="4"
                                  maxlength="2200"
                                  placeholder="Clique em 'Gerar Imagem pelo Prompt' para preencher automaticamente a legenda com hashtags do nicho, ou escreva aqui..."></textarea>
                    </div>

                    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;flex-wrap:wrap;">
                        <label style="display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer;">
                            <input type="checkbox" name="publicarImediatamente" value="true" />
                            Publicar imediatamente no Instagram agora
                        </label>

                        <button type="submit" id="btnSubmitEstudio" class="btn btn-primary" style="min-height:42px;padding:10px 20px;">
                            🚀 Montar Imagem e Já Agendar para Postar
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </section>

    <!-- 1. AGENDAR NOVO POST (FEED, STORIES OU FEED + STORIES) -->
    <section class="dash-section">
        <h2 class="dash-section-title">1. Agendar Nova Publicação (Foto do Celular/PC ou Link)</h2>
        <p class="dash-section-desc">
            Envie uma foto pronta do seu celular/computador (ou cole o link da imagem), escolha para qual Instagram vai a publicação, escreva a legenda e agende.
        </p>

        <form method="post"
              asp-page-handler="CriarPostAgendado"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="split-layout">
                <div class="preview-col">
                    <div style="width:155px;height:155px;background:var(--panel-alt);border:1px dashed #473869;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:8px;text-align:center;color:var(--muted);font-size:11px;">
                        <img id="postPreviewImg" alt="Prévia do Post" style="display:none;width:100%;height:100%;object-fit:cover;" />
                        <span id="postPreviewText">Prévia da Imagem do Post</span>
                    </div>
                    <small style="color:var(--muted);font-size:10px;text-align:center;">JPG, PNG ou WebP (máx. 8 MB)</small>
                </div>

                <div style="min-width:0;max-width:100%;">
                    <div class="form-grid">
                        <div class="field">
                            <label for="postContaIg">Para qual Instagram vai este post?</label>
                            <select id="postContaIg" name="instagramContaId" required>
                                @foreach (var conta in Model.ContasDisponiveis)
                                {
                                    <option value="@conta.Id" selected="@(Model.ContaSelecionada?.Id == conta.Id ? "selected" : null)">
                                        @conta.IdentificadorInstagram — @conta.NomeCadastro
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="field">
                            <label for="postTitulo">Título de identificação</label>
                            <input id="postTitulo"
                                   name="titulo"
                                   type="text"
                                   placeholder="Ex.: Post Oferta do Dia / Comunicado"
                                   required />
                        </div>

                        <div class="field">
                            <label for="postTipo">Onde publicar?</label>
                            <select id="postTipo" name="tipoPublicacao">
                                <option value="@TipoMidiaInstagram.Feed">Somente no Feed</option>
                                <option value="@TipoMidiaInstagram.FeedEStories">No Feed + Nos Stories</option>
                                <option value="@TipoMidiaInstagram.Stories">Somente nos Stories</option>
                            </select>
                        </div>

                        <div class="field">
                            <label for="postArquivo">Subir imagem do celular ou PC</label>
                            <input id="postArquivo"
                                   name="arquivoImagem"
                                   type="file"
                                   accept="image/jpeg,image/png,image/webp" />
                        </div>

                        <div class="field">
                            <label for="postUrlExterna">Ou URL pública da imagem (opcional)</label>
                            <input id="postUrlExterna"
                                   name="urlImagemExterna"
                                   type="url"
                                   placeholder="https://..." />
                        </div>

                        <div class="field">
                            <label for="postModoHorario">Horário do agendamento</label>
                            <select id="postModoHorario" name="modoHorario">
                                <option value="auto" selected>
                                    Próximo horário livre (@proximoSlotPadrao.ToString("dd/MM HH:mm"))
                                </option>
                                <option value="manual">Escolher data e hora específica</option>
                            </select>
                        </div>

                        <div class="field" id="campoHorarioManualPost" style="display:none;">
                            <label for="postHorarioManual">Data e hora (America/Sao_Paulo)</label>
                            <input id="postHorarioManual"
                                   name="horarioEspecificoLocal"
                                   type="datetime-local"
                                   value="@proximoSlotPadrao.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture)" />
                        </div>
                    </div>

                    <div class="field" style="margin-top:14px;">
                        <label for="postLegenda">Legenda da publicação no Instagram (máx. 2.200 caracteres)</label>
                        <textarea id="postLegenda"
                                  name="legenda"
                                  rows="4"
                                  maxlength="2200"
                                  placeholder="Escreva a legenda com emojis, chamada e hashtags..."></textarea>
                    </div>

                    <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:14px;flex-wrap:wrap;">
                        <label style="display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer;">
                            <input type="checkbox" name="publicarImediatamente" value="true" />
                            Publicar imediatamente no Instagram após salvar
                        </label>

                        <button type="submit" class="btn btn-primary" style="min-height:42px;padding:10px 20px;">
                            Confirmar e Agendar Publicação
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </section>

    <!-- 2. CRIAR E PROGRAMAR STORY AUTOMÁTICO RECORRENTE (ARTE PRONTA 9:16) -->
    <section class="dash-section">
        <h2 class="dash-section-title">2. Programar Story Automático (Arte Pronta 9:16 do Celular/PC)</h2>
        <p class="dash-section-desc">
            Suba sua arte vertical pronta (1080x1920) e programe para o sistema postar automaticamente todo dia nos horários escolhidos ou em uma data única.
        </p>

        <form method="post"
              asp-page-handler="CriarStoryRecorrente"
              enctype="multipart/form-data"
              style="padding:16px;background:var(--panel-alt);border:1px solid var(--border);border-radius:12px;margin-bottom:18px;">
            @Html.AntiForgeryToken()

            <div class="split-layout">
                <div class="preview-col">
                    <div style="width:136px;height:240px;background:#0d0b14;border:1px dashed #473869;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:8px;text-align:center;color:var(--muted);font-size:11px;">
                        <img id="storyPreviewImg" alt="Prévia Story" style="display:none;width:100%;height:100%;object-fit:cover;" />
                        <span id="storyPreviewText">Prévia Vertical 9:16 do Story</span>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="field">
                        <label for="storyContaIg">Para qual Instagram é este Story?</label>
                        <select id="storyContaIg" name="instagramContaId" required>
                            @foreach (var conta in Model.ContasDisponiveis)
                            {
                                <option value="@conta.Id" selected="@(Model.ContaSelecionada?.Id == conta.Id ? "selected" : null)">
                                    @conta.IdentificadorInstagram — @conta.NomeCadastro
                                </option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="storyTitulo">Nome de identificação do Story</label>
                        <input id="storyTitulo"
                               name="titulo"
                               type="text"
                               value="Story Chamada / Link na Bio"
                               required />
                    </div>

                    <div class="field">
                        <label for="storyImagemInput">Arte vertical do celular ou PC</label>
                        <input id="storyImagemInput"
                               name="imagemStory"
                               type="file"
                               accept="image/jpeg,image/png,image/webp"
                               required />
                    </div>

                    <div class="field">
                        <label for="storyModo">Frequência de publicação</label>
                        <select id="storyModo" name="modoAgendamento">
                            <option value="@ModoStoryRecorrente.RecorrenteDiario" selected>
                                Todo dia automaticamente nos horários programados
                            </option>
                            <option value="@ModoStoryRecorrente.UnicaVez">
                                Apenas uma vez na data e hora escolhida
                            </option>
                        </select>
                    </div>

                    <div class="field" id="campoHorariosStory">
                        <label for="storyHorarios">Horários diários do Story (HH:mm)</label>
                        <input id="storyHorarios"
                               name="horariosDiarios"
                               type="text"
                               value="10:00, 19:00"
                               placeholder="10:00, 15:00, 20:00" />
                    </div>

                    <div class="field" id="campoDataUnicaStory" style="display:none;">
                        <label for="storyDataUnica">Data e hora única (America/Sao_Paulo)</label>
                        <input id="storyDataUnica"
                               name="dataHoraUnicaLocal"
                               type="datetime-local"
                               value="@Model.AgoraSaoPaulo.AddHours(1).ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture)" />
                    </div>

                    <div class="field" style="justify-content:flex-end;">
                        <button type="submit" class="btn btn-primary" style="min-height:42px;">
                            Salvar e Programar Story
                        </button>
                    </div>
                </div>
            </div>
        </form>

        @if (Model.StoriesRecorrentes.Count > 0)
        {
            <div class="queue-list">
                @foreach (var story in Model.StoriesRecorrentes)
                {
                    var horariosTexto = Model.ObterHorariosStoryTexto(story);
                    <div class="queue-item">
                        <div>
                            <img src="/media/story/@(story.Id).jpg?v=@(story.CriadoEmUtc.UtcTicks)"
                                 alt="@story.Titulo"
                                 style="width:96px;height:170px;object-fit:cover;border-radius:9px;border:1px solid var(--border);"
                                 loading="lazy" />
                        </div>

                        <div>
                            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:8px;">
                                <div>
                                    <strong style="font-size:14px;color:#fff;">Story #@story.Id — @story.Titulo</strong>
                                    <span class="pill agendado" style="margin-left:8px;">@story.IdentificadorInstagram</span>
                                    <div style="font-size:11.5px;color:var(--muted);margin-top:4px;">
                                        Próximo disparo: <strong style="color:#fff;">@story.ProximoDisparoLocal.ToString("dd/MM/yyyy 'às' HH:mm", cultura)</strong>
                                        · Total enviado: <strong>@story.TotalPublicacoes vez(es)</strong>
                                    </div>
                                </div>

                                <span class="pill @(story.Ativo ? "publicado" : "cancelado")">
                                    @(story.Ativo ? "Automático Ativo" : story.Status)
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(story.UltimoErro))
                            {
                                <div style="margin-bottom:10px;padding:8px 11px;background:#3b1c26;border:1px solid #7b3248;border-radius:7px;color:#ffb4b4;font-size:11.5px;">
                                    <strong>Erro:</strong> @story.UltimoErro
                                </div>
                            }

                            <form method="post" asp-page-handler="EditarStoryRecorrente" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="storyId" value="@story.Id" />

                                <div class="form-grid">
                                    <div class="field">
                                        <label>Instagram</label>
                                        <select name="instagramContaId">
                                            @foreach (var c in Model.ContasDisponiveis)
                                            {
                                                <option value="@c.Id" selected="@(story.InstagramContaId == c.Id ? "selected" : null)">
                                                    @c.IdentificadorInstagram
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label>Título</label>
                                        <input type="text" name="titulo" value="@story.Titulo" required />
                                    </div>
                                    <div class="field">
                                        <label>Modo</label>
                                        <select name="modoAgendamento">
                                            <option value="@ModoStoryRecorrente.RecorrenteDiario"
                                                    selected="@(story.ModoAgendamento == ModoStoryRecorrente.RecorrenteDiario ? "selected" : null)">
                                                Todo dia nos horários
                                            </option>
                                            <option value="@ModoStoryRecorrente.UnicaVez"
                                                    selected="@(story.ModoAgendamento == ModoStoryRecorrente.UnicaVez ? "selected" : null)">
                                                Única vez
                                            </option>
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label>Horários (HH:mm)</label>
                                        <input type="text" name="horariosDiarios" value="@horariosTexto" />
                                    </div>
                                    <div class="field">
                                        <label>Data/Hora Única</label>
                                        <input type="datetime-local"
                                               name="dataHoraUnicaLocal"
                                               value="@((story.DataHoraUnicaLocal ?? story.ProximoDisparoLocal).ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture))" />
                                    </div>
                                    <div class="field">
                                        <label>Trocar arte (opcional)</label>
                                        <input type="file" name="novaImagemStory" accept="image/jpeg,image/png,image/webp" />
                                    </div>
                                </div>

                                <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
                                    <button type="submit" class="btn btn-secondary">Salvar Alterações</button>
                                </div>
                            </form>

                            <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
                                <form method="post" asp-page-handler="PublicarStoryAgora" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storyId" value="@story.Id" />
                                    <button type="submit" class="btn btn-primary">Publicar este Story agora</button>
                                </form>

                                <form method="post" asp-page-handler="AlternarStoryAtivo" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storyId" value="@story.Id" />
                                    <button type="submit" class="btn btn-secondary">
                                        @(story.Ativo ? "Pausar" : "Ativar")
                                    </button>
                                </form>

                                <form method="post"
                                      asp-page-handler="ExcluirStory"
                                      style="margin:0;"
                                      onsubmit="return confirm('Deseja excluir este Story programado?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storyId" value="@story.Id" />
                                    <button type="submit" class="btn btn-danger">Excluir</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- 3. FILA DE POSTS AGENDADOS E HISTÓRICO -->
    <section class="dash-section">
        <h2 class="dash-section-title">3. Fila de Agendamentos e Histórico de Publicações</h2>
        <p class="dash-section-desc">
            Acompanhe, edite a legenda ou horário, publique imediatamente ou cancele qualquer postagem agendada.
        </p>

        @if (Model.PostsAgendados.Count == 0)
        {
            <div style="padding:28px;text-align:center;color:var(--muted);">
                Nenhuma publicação agendada na fila para este Instagram.
            </div>
        }
        else
        {
            <div class="queue-list">
                @foreach (var post in Model.PostsAgendados)
                {
                    var pillClass = post.Status switch
                    {
                        StatusPostInstagram.Publicado => "publicado",
                        StatusPostInstagram.Falha => "falha",
                        StatusPostInstagram.Cancelado => "cancelado",
                        _ => "agendado"
                    };

                    var imgSrc = !string.IsNullOrWhiteSpace(post.UrlImagemExterna)
                        ? post.UrlImagemExterna
                        : $"/media/post/{post.Id}.jpg?v={post.CriadoEmUtc.UtcTicks}";

                    <div class="queue-item">
                        <div>
                            <img src="@imgSrc"
                                 alt="@post.Titulo"
                                 style="width:98px;height:98px;object-fit:cover;border-radius:9px;border:1px solid var(--border);background:#0d0b14;"
                                 loading="lazy" />
                        </div>

                        <div>
                            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:8px;">
                                <div>
                                    <strong style="font-size:14px;color:#fff;">#@post.Id — @post.Titulo</strong>
                                    <span class="pill agendado" style="margin-left:8px;">@post.IdentificadorInstagram</span>
                                    <span class="pill cancelado" style="margin-left:4px;">@post.TipoPublicacao</span>
                                    <div style="font-size:11.5px;color:var(--muted);margin-top:4px;">
                                        Programado para: <strong style="color:#fff;">@post.HorarioProgramadoLocal.ToString("dd/MM/yyyy 'às' HH:mm", cultura)</strong>
                                        @if (!string.IsNullOrWhiteSpace(post.MediaIdMeta))
                                        {
                                            <span> · Media ID Meta: <code>@post.MediaIdMeta</code></span>
                                        }
                                    </div>
                                </div>

                                <span class="pill @pillClass">@post.Status</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(post.UltimoErro))
                            {
                                <div style="margin-bottom:10px;padding:8px 11px;background:#3b1c26;border:1px solid #7b3248;border-radius:7px;color:#ffb4b4;font-size:11.5px;">
                                    <strong>Erro:</strong> @post.UltimoErro (Tentativas: @post.Tentativas)
                                </div>
                            }

                            @if (post.Status != StatusPostInstagram.Publicado)
                            {
                                <form method="post" asp-page-handler="EditarPostAgendado" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@post.Id" />

                                    <div class="form-grid">
                                        <div class="field">
                                            <label>Instagram</label>
                                            <select name="instagramContaId">
                                                @foreach (var c in Model.ContasDisponiveis)
                                                {
                                                    <option value="@c.Id" selected="@(post.InstagramContaId == c.Id ? "selected" : null)">
                                                        @c.IdentificadorInstagram
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="field">
                                            <label>Título</label>
                                            <input type="text" name="titulo" value="@post.Titulo" required />
                                        </div>

                                        <div class="field">
                                            <label>Data e horário (America/Sao_Paulo)</label>
                                            <input type="datetime-local"
                                                   name="horarioProgramadoLocal"
                                                   value="@post.HorarioProgramadoLocal.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture)"
                                                   required />
                                        </div>

                                        <div class="field">
                                            <label>Onde publicar</label>
                                            <select name="tipoPublicacao">
                                                <option value="@TipoMidiaInstagram.Feed" selected="@(post.TipoPublicacao == TipoMidiaInstagram.Feed ? "selected" : null)">Feed</option>
                                                <option value="@TipoMidiaInstagram.FeedEStories" selected="@(post.TipoPublicacao == TipoMidiaInstagram.FeedEStories ? "selected" : null)">Feed + Stories</option>
                                                <option value="@TipoMidiaInstagram.Stories" selected="@(post.TipoPublicacao == TipoMidiaInstagram.Stories ? "selected" : null)">Somente Stories</option>
                                            </select>
                                        </div>

                                        <div class="field">
                                            <label>Trocar imagem (opcional)</label>
                                            <input type="file" name="novaImagem" accept="image/jpeg,image/png,image/webp" />
                                        </div>
                                    </div>

                                    <div class="field" style="margin-top:10px;">
                                        <label>Legenda</label>
                                        <textarea name="legenda" rows="3" maxlength="2200">@post.Legenda</textarea>
                                    </div>

                                    <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">
                                        <button type="submit" class="btn btn-secondary">
                                            Salvar Alterações @(post.Status != StatusPostInstagram.Agendado ? "(Reativar)" : "")
                                        </button>
                                    </div>
                                </form>

                                <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
                                    <form method="post" asp-page-handler="PublicarPostAgora" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@post.Id" />
                                        <button type="submit" class="btn btn-primary">Publicar Agora</button>
                                    </form>

                                    @if (post.Status != StatusPostInstagram.Cancelado)
                                    {
                                        <form method="post" asp-page-handler="CancelarPost" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="postId" value="@post.Id" />
                                            <button type="submit" class="btn btn-secondary">Cancelar</button>
                                        </form>
                                    }

                                    <form method="post"
                                          asp-page-handler="ExcluirPost"
                                          style="margin:0;"
                                          onsubmit="return confirm('Deseja excluir este agendamento?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@post.Id" />
                                        <button type="submit" class="btn btn-danger">Excluir</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <details style="margin-top:8px;font-size:12px;color:var(--muted);">
                                    <summary style="cursor:pointer;">Ver legenda publicada</summary>
                                    <pre style="white-space:pre-wrap;background:#0d0b14;padding:10px;border-radius:7px;color:#eadff7;margin-top:6px;">@post.Legenda</pre>
                                </details>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

<script>
    (() => {
        const postModoHorario = document.getElementById("postModoHorario");
        const campoHorarioManualPost = document.getElementById("campoHorarioManualPost");
        if (postModoHorario && campoHorarioManualPost) {
            const togglePostHorario = () => {
                campoHorarioManualPost.style.display = postModoHorario.value === "manual" ? "flex" : "none";
            };
            postModoHorario.addEventListener("change", togglePostHorario);
            togglePostHorario();
        }

        const postArquivo = document.getElementById("postArquivo");
        const postPreviewImg = document.getElementById("postPreviewImg");
        const postPreviewText = document.getElementById("postPreviewText");
        if (postArquivo && postPreviewImg && postPreviewText) {
            postArquivo.addEventListener("change", () => {
                const f = postArquivo.files && postArquivo.files[0];
                if (!f) {
                    postPreviewImg.style.display = "none";
                    postPreviewText.style.display = "inline";
                    return;
                }
                const r = new FileReader();
                r.onload = e => {
                    postPreviewImg.src = e.target.result;
                    postPreviewImg.style.display = "block";
                    postPreviewText.style.display = "none";
                };
                r.readAsDataURL(f);
            });
        }

        const storyImagemInput = document.getElementById("storyImagemInput");
        const storyPreviewImg = document.getElementById("storyPreviewImg");
        const storyPreviewText = document.getElementById("storyPreviewText");
        if (storyImagemInput && storyPreviewImg && storyPreviewText) {
            storyImagemInput.addEventListener("change", () => {
                const f = storyImagemInput.files && storyImagemInput.files[0];
                if (!f) {
                    storyPreviewImg.style.display = "none";
                    storyPreviewText.style.display = "inline";
                    return;
                }
                const r = new FileReader();
                r.onload = e => {
                    storyPreviewImg.src = e.target.result;
                    storyPreviewImg.style.display = "block";
                    storyPreviewText.style.display = "none";
                };
                r.readAsDataURL(f);
            });
        }

        const storyModo = document.getElementById("storyModo");
        const campoHorariosStory = document.getElementById("campoHorariosStory");
        const campoDataUnicaStory = document.getElementById("campoDataUnicaStory");
        if (storyModo && campoHorariosStory && campoDataUnicaStory) {
            const toggleStoryModo = () => {
                const unica = storyModo.value === "@ModoStoryRecorrente.UnicaVez";
                campoHorariosStory.style.display = unica ? "none" : "flex";
                campoDataUnicaStory.style.display = unica ? "flex" : "none";
            };
            storyModo.addEventListener("change", toggleStoryModo);
            toggleStoryModo();
        }

        // =====================================================================
        // ESTÚDIO CRIADOR DE IMAGEM IA POR NICHO + PROMPT
        // =====================================================================
        const canvas = document.getElementById("studioCanvasPreview");
        const btnGerarPrevia = document.getElementById("btnGerarPreviaPrompt");
        const studioContaIg = document.getElementById("studioContaIg");
        const studioModeloIa = document.getElementById("studioModeloIa");
        const studioApiKey = document.getElementById("studioApiKey");
        const studioFormato = document.getElementById("studioFormato");
        const studioEstiloArte = document.getElementById("studioEstiloArte");
        const studioPrompt = document.getElementById("studioPrompt");
        const studioSelo = document.getElementById("studioSelo");
        const studioTituloArte = document.getElementById("studioTituloArte");
        const studioSubtituloArte = document.getElementById("studioSubtituloArte");
        const studioLegenda = document.getElementById("studioLegenda");
        const studioStatusLabel = document.getElementById("studioStatusLabel");
        const studioBase64Input = document.getElementById("studioImagemCompostaBase64");
        const studioModoHorario = document.getElementById("studioModoHorario");
        const studioBlocoModoHorario = document.getElementById("studioBlocoModoHorario");
        const studioCampoHorarioManual = document.getElementById("studioCampoHorarioManual");
        const studioCampoHorariosStory = document.getElementById("studioCampoHorariosStory");
        const formEstudioPrompt = document.getElementById("formEstudioPrompt");

        let imagemFundoCarregada = null;
        let posterMetadata = {
            beneficios: [],
            cta: "",
            whatsapp: "",
            rodape: ""
        };

        try {
            const savedKey = localStorage.getItem("agendador_pro_ai_key");
            if (savedKey && studioApiKey) studioApiKey.value = savedKey;
            if (studioApiKey) {
                studioApiKey.addEventListener("change", () => {
                    try { localStorage.setItem("agendador_pro_ai_key", studioApiKey.value.trim()); } catch { }
                });
            }
        } catch { }

        function atualizarCamposHorarioEstudio() {
            if (!studioFormato) return;
            const ehRecorrente = studioFormato.value === "StoryRecorrente";
            if (studioBlocoModoHorario) {
                studioBlocoModoHorario.style.display = ehRecorrente ? "none" : "flex";
            }
            if (studioCampoHorariosStory) {
                studioCampoHorariosStory.style.display = ehRecorrente ? "flex" : "none";
            }
            if (studioCampoHorarioManual && studioModoHorario) {
                studioCampoHorarioManual.style.display = (!ehRecorrente && studioModoHorario.value === "manual") ? "flex" : "none";
            }
        }

        if (studioFormato) {
            studioFormato.addEventListener("change", () => {
                atualizarCamposHorarioEstudio();
                desenharArteNoCanvas();
            });
        }
        if (studioModoHorario) {
            studioModoHorario.addEventListener("change", atualizarCamposHorarioEstudio);
        }
        atualizarCamposHorarioEstudio();

        function quebrarLinhasTexto(ctx, texto, maxWidth) {
            const palavras = (texto || "").split(/\s+/).filter(Boolean);
            const linhas = [];
            let atual = "";
            for (const p of palavras) {
                const teste = atual ? `${atual} ${p}` : p;
                if (ctx.measureText(teste).width > maxWidth && atual) {
                    linhas.push(atual);
                    atual = p;
                } else {
                    atual = teste;
                }
            }
            if (atual) linhas.push(atual);
            return linhas.slice(0, 4);
        }

        function desenharArteNoCanvas() {
            if (!canvas) return;
            const textoPrompt = (studioPrompt && studioPrompt.value) || "";
            const pedeVerticalNoPrompt = /9:16|1080x1920|vertical/i.test(textoPrompt);
            const ehVertical = (studioFormato && (studioFormato.value === "Stories" || studioFormato.value === "StoryRecorrente")) || pedeVerticalNoPrompt;
            const W = 1080;
            const H = ehVertical ? 1920 : 1080;
            if (canvas.width !== W || canvas.height !== H) {
                canvas.width = W;
                canvas.height = H;
            }

            const ctx = canvas.getContext("2d");
            ctx.clearRect(0, 0, W, H);

            // 1. Fundo: Imagem gerada por IA
            if (imagemFundoCarregada) {
                const imgRatio = imagemFundoCarregada.width / imagemFundoCarregada.height;
                const canvasRatio = W / H;
                let drawW = W, drawH = H, offsetX = 0, offsetY = 0;
                if (imgRatio > canvasRatio) {
                    drawW = H * imgRatio;
                    offsetX = (W - drawW) / 2;
                } else {
                    drawH = W / imgRatio;
                    offsetY = (H - drawH) / 2;
                }
                ctx.drawImage(imagemFundoCarregada, offsetX, offsetY, drawW, drawH);
            } else {
                const bgGrad = ctx.createLinearGradient(0, 0, W, H);
                bgGrad.addColorStop(0, "#051810");
                bgGrad.addColorStop(0.5, "#09261a");
                bgGrad.addColorStop(1, "#040d09");
                ctx.fillStyle = bgGrad;
                ctx.fillRect(0, 0, W, H);
            }

            const modoEstilo = studioEstiloArte ? studioEstiloArte.value : "poster";
            if (modoEstilo === "limpo") {
                if (studioBase64Input && imagemFundoCarregada) {
                    try { studioBase64Input.value = canvas.toDataURL("image/jpeg", 0.92); } catch { }
                }
                return;
            }

            const tituloRaw = (studioTituloArte && studioTituloArte.value.trim()) || "SCOOTER ACHADINHOS";
            const selo = (studioSelo && studioSelo.value.trim()) || "As melhores ofertas em Scooter e Acessórios!";
            const subtitulo = (studioSubtituloArte && studioSubtituloArte.value.trim()) || posterMetadata.cta || "Entre no nosso grupo e não perca nenhuma oferta!";

            if (modoEstilo === "poster") {
                // Vinheta de topo e base para destacar o cabeçalho 3D e o rodapé WhatsApp sem esconder a moto no centro
                const topGrad = ctx.createLinearGradient(0, 0, 0, H * 0.30);
                topGrad.addColorStop(0, "rgba(3, 12, 8, 0.90)");
                topGrad.addColorStop(1, "rgba(3, 12, 8, 0.0)");
                ctx.fillStyle = topGrad;
                ctx.fillRect(0, 0, W, H * 0.30);

                const botGrad = ctx.createLinearGradient(0, H * 0.62, 0, H);
                botGrad.addColorStop(0, "rgba(3, 12, 8, 0.0)");
                botGrad.addColorStop(0.45, "rgba(4, 15, 10, 0.82)");
                botGrad.addColorStop(1, "rgba(2, 10, 6, 0.96)");
                ctx.fillStyle = botGrad;
                ctx.fillRect(0, H * 0.62, W, H * 0.38);

                // Cabeçalho Principal 3D (divide 1ª palavra em branco metálico e resto em gradiente laranja/amarelo)
                const partesTitulo = tituloRaw.toUpperCase().split(/\s+/);
                const primeiraPalavra = partesTitulo[0] || "SCOOTER";
                const restoPalavras = partesTitulo.slice(1).join(" ") || "";

                ctx.save();
                ctx.textAlign = "center";
                ctx.shadowColor = "#22c55e";
                ctx.shadowBlur = 28;
                ctx.lineWidth = 14;
                ctx.strokeStyle = "#040b07";

                ctx.font = "900 94px Inter, Segoe UI, Impact, Arial, sans-serif";
                ctx.strokeText(primeiraPalavra, W / 2, 145);
                ctx.fillStyle = "#f8fafc";
                ctx.fillText(primeiraPalavra, W / 2, 145);

                if (restoPalavras) {
                    ctx.font = "900 84px Inter, Segoe UI, Impact, Arial, sans-serif";
                    ctx.strokeText(restoPalavras, W / 2, 232);
                    const gradLaranja = ctx.createLinearGradient(W * 0.2, 170, W * 0.8, 240);
                    gradLaranja.addColorStop(0, "#facc15");
                    gradLaranja.addColorStop(0.5, "#fb923c");
                    gradLaranja.addColorStop(1, "#f97316");
                    ctx.fillStyle = gradLaranja;
                    ctx.fillText(restoPalavras, W / 2, 232);
                }
                ctx.restore();

                // Subtítulo abaixo do cabeçalho
                ctx.save();
                ctx.textAlign = "center";
                ctx.font = "800 33px Inter, Segoe UI, Arial, sans-serif";
                ctx.fillStyle = "#fef08a";
                ctx.shadowColor = "#000000";
                ctx.shadowBlur = 10;
                ctx.fillText(selo, W / 2, restoPalavras ? 286 : 210);
                ctx.restore();

                // Painéis de Benefícios na lateral direita (com borda verde neon)
                const listaBeneficios = posterMetadata.beneficios && posterMetadata.beneficios.length > 0
                    ? posterMetadata.beneficios
                    : ["Descontos Imperdíveis", "Ofertas Confiáveis", "Receba em Primeira Mão"];

                if (ehVertical) {
                    let boxY = 620;
                    listaBeneficios.forEach(item => {
                        const boxW = 430;
                        const boxH = 74;
                        const boxX = W - boxW - 44;

                        ctx.save();
                        ctx.fillStyle = "rgba(5, 16, 11, 0.86)";
                        ctx.strokeStyle = "#22c55e";
                        ctx.lineWidth = 4;
                        ctx.shadowColor = "#22c55e";
                        ctx.shadowBlur = 16;
                        ctx.beginPath();
                        ctx.roundRect(boxX, boxY, boxW, boxH, 16);
                        ctx.fill();
                        ctx.stroke();
                        ctx.restore();

                        ctx.fillStyle = "#4ade80";
                        ctx.font = "900 30px Inter, Segoe UI, Arial, sans-serif";
                        ctx.textAlign = "left";
                        ctx.fillText("✔", boxX + 22, boxY + 48);

                        ctx.fillStyle = "#ffffff";
                        ctx.font = "800 26px Inter, Segoe UI, Arial, sans-serif";
                        ctx.fillText(item, boxX + 62, boxY + 47);

                        boxY += 94;
                    });
                }

                // Faixa Diagonal Amarela de Call-To-Action
                const ctaY = H - (ehVertical ? 360 : 230);
                ctx.save();
                ctx.translate(W / 2, ctaY);
                ctx.rotate(-0.025);
                const bannerGrad = ctx.createLinearGradient(-460, -40, 460, 40);
                bannerGrad.addColorStop(0, "#fde047");
                bannerGrad.addColorStop(1, "#facc15");
                ctx.fillStyle = bannerGrad;
                ctx.shadowColor = "rgba(0,0,0,0.75)";
                ctx.shadowBlur = 20;
                ctx.beginPath();
                ctx.roundRect(-470, -44, 940, 88, 18);
                ctx.fill();

                ctx.fillStyle = "#052e16";
                ctx.font = "900 31px Inter, Segoe UI, Arial, sans-serif";
                ctx.textAlign = "center";
                ctx.fillText(subtitulo, 0, 11);
                ctx.restore();

                // Botão Neon Verde do WhatsApp
                const wppTexto = posterMetadata.whatsapp || "Grupo no WhatsApp";
                const wppY = H - (ehVertical ? 235 : 135);
                ctx.save();
                const wppGrad = ctx.createLinearGradient(W / 2 - 330, wppY, W / 2 + 330, wppY + 96);
                wppGrad.addColorStop(0, "#16a34a");
                wppGrad.addColorStop(0.5, "#22c55e");
                wppGrad.addColorStop(1, "#15803d");
                ctx.fillStyle = wppGrad;
                ctx.strokeStyle = "#86efac";
                ctx.lineWidth = 4;
                ctx.shadowColor = "#22c55e";
                ctx.shadowBlur = 30;
                ctx.beginPath();
                ctx.roundRect(W / 2 - 330, wppY, 660, 96, 48);
                ctx.fill();
                ctx.stroke();

                ctx.fillStyle = "#ffffff";
                ctx.font = "900 42px Inter, Segoe UI, Arial, sans-serif";
                ctx.textAlign = "center";
                ctx.fillText(`📲 ${wppTexto}`, W / 2, wppY + 63);
                ctx.restore();

                // Rodapé
                const rodapeTexto = posterMetadata.rodape || "Scooter Achadinhos — Sempre com Você!";
                ctx.fillStyle = "#fef08a";
                ctx.font = "italic 700 28px Inter, Segoe UI, Georgia, sans-serif";
                ctx.textAlign = "center";
                ctx.fillText(rodapeTexto, W / 2, H - 52);
            } else {
                // Estilo Moldura Simples
                const overlayGrad = ctx.createLinearGradient(0, H * 0.25, 0, H);
                overlayGrad.addColorStop(0, "rgba(10, 9, 18, 0.05)");
                overlayGrad.addColorStop(0.55, "rgba(10, 9, 18, 0.68)");
                overlayGrad.addColorStop(1, "rgba(8, 7, 15, 0.94)");
                ctx.fillStyle = overlayGrad;
                ctx.fillRect(0, 0, W, H);

                const baseBottomY = H - (ehVertical ? 210 : 120);
                ctx.fillStyle = "#ffffff";
                ctx.font = "900 62px Inter, Segoe UI, Arial, sans-serif";
                ctx.textAlign = "left";
                const linhasTitulo = quebrarLinhasTexto(ctx, tituloRaw.toUpperCase(), W - 160);
                const alturaLinha = 74;
                const inicioTituloY = baseBottomY - (linhasTitulo.length * alturaLinha) - 55;

                linhasTitulo.forEach((linha, idx) => {
                    ctx.fillText(linha, 80, inicioTituloY + (idx + 1) * alturaLinha - 14);
                });

                ctx.fillStyle = "#38bdf8";
                ctx.font = "700 34px Inter, Segoe UI, Arial, sans-serif";
                ctx.fillText(subtitulo, 80, baseBottomY);
            }

            if (studioBase64Input && imagemFundoCarregada) {
                try {
                    studioBase64Input.value = canvas.toDataURL("image/jpeg", 0.92);
                } catch { }
            }
        }

        [studioSelo, studioTituloArte, studioSubtituloArte, studioEstiloArte, studioPrompt, studioContaIg].forEach(el => {
            if (el) {
                el.addEventListener("input", desenharArteNoCanvas);
                el.addEventListener("change", desenharArteNoCanvas);
            }
        });

        async function gerarArteViaServidor() {
            if (!studioPrompt || !studioPrompt.value.trim()) {
                alert("Digite ou cole o seu Prompt antes de gerar a imagem.");
                studioPrompt?.focus();
                return false;
            }

            const prompt = studioPrompt.value.trim();
            if (/9:16|1080x1920|vertical/i.test(prompt) && studioFormato && studioFormato.value === "Feed") {
                studioFormato.value = "Stories";
                atualizarCamposHorarioEstudio();
            }

            const modeloIa = studioModeloIa ? studioModeloIa.value : "flux";
            const formato = studioFormato ? studioFormato.value : "Feed";
            const apiKeyManual = studioApiKey ? studioApiKey.value.trim() : "";
            let arroba = "";
            if (studioContaIg && studioContaIg.selectedOptions.length > 0) {
                arroba = studioContaIg.selectedOptions[0].getAttribute("data-arroba") || "";
            }

            if (btnGerarPrevia) {
                btnGerarPrevia.disabled = true;
                btnGerarPrevia.textContent = "⏳ Gerando foto real via IA...";
            }
            if (studioStatusLabel) {
                studioStatusLabel.textContent = "Gerando imagem na IA (leva ~8 a 15 segundos)...";
            }

            try {
                const res = await fetch("/api/criador/gerar-imagem", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        prompt,
                        formato,
                        arroba,
                        modeloIa,
                        apiKeyManual,
                        titulo: studioTituloArte ? studioTituloArte.value.trim() : "",
                        selo: studioSelo ? studioSelo.value.trim() : "",
                        subtitulo: studioSubtituloArte ? studioSubtituloArte.value.trim() : ""
                    })
                });

                const dados = await res.json();
                if (!res.ok || !dados.sucesso) {
                    throw new Error(dados.erro || "Falha ao gerar imagem na IA.");
                }

                posterMetadata = {
                    beneficios: dados.beneficiosExtraidos || [],
                    cta: dados.chamadaCta || "",
                    whatsapp: dados.botaoWhatsapp || "",
                    rodape: dados.rodapeTexto || ""
                };

                if (studioSelo && dados.seloTopo) {
                    studioSelo.value = dados.seloTopo;
                }
                if (studioTituloArte && dados.tituloArte) {
                    studioTituloArte.value = dados.tituloArte;
                }
                if (studioSubtituloArte && dados.subtituloArte) {
                    studioSubtituloArte.value = dados.subtituloArte;
                }
                if (studioLegenda && (!studioLegenda.value.trim() || dados.legendaSugerida)) {
                    studioLegenda.value = dados.legendaSugerida || "";
                }

                await new Promise((resolve, reject) => {
                    const img = new Image();
                    img.onload = () => {
                        imagemFundoCarregada = img;
                        desenharArteNoCanvas();
                        resolve();
                    };
                    img.onerror = () => reject(new Error("Erro ao renderizar a imagem retornada pela IA."));
                    img.src = dados.imagemBase64DataUrl;
                });

                if (studioStatusLabel) {
                    studioStatusLabel.textContent = `✅ Gerada via ${dados.provedorIa} (${dados.largura}x${dados.altura})!`;
                }
                return true;
            } catch (err) {
                if (studioStatusLabel) {
                    studioStatusLabel.textContent = `⚠️ ${err.message || "Erro ao consultar IA."}`;
                }
                alert(err.message || "Erro ao gerar imagem na IA.");
                return false;
            } finally {
                if (btnGerarPrevia) {
                    btnGerarPrevia.disabled = false;
                    btnGerarPrevia.textContent = "🎨 Gerar Imagem pelo Prompt";
                }
            }
        }

        if (btnGerarPrevia) {
            btnGerarPrevia.addEventListener("click", () => {
                gerarArteViaServidor();
            });
        }

        if (formEstudioPrompt) {
            formEstudioPrompt.addEventListener("submit", () => {
                if (canvas && studioBase64Input && imagemFundoCarregada) {
                    try {
                        desenharArteNoCanvas();
                        studioBase64Input.value = canvas.toDataURL("image/jpeg", 0.90);
                    } catch { }
                }
                const btnSub = document.getElementById("btnSubmitEstudio");
                if (btnSub) {
                    btnSub.textContent = "⏳ Montando imagem e agendando...";
                }
            });
        }

        desenharArteNoCanvas();
    })();
</script>
