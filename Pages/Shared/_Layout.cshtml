@{
    var usuarioLogado = Context.User.FindFirst("NomeExibicao")?.Value
        ?? Context.User.Identity?.Name
        ?? "Usuário";
    var instagramVinculado = Context.User.FindFirst("InstagramHandle")?.Value
        ?? "Perfil Vinculado";
    var ehAdmin = Context.User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0b14" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Agendador Pro" />
    <title>@ViewData["Title"] - Agendador Pro</title>

    <link rel="manifest" href="~/manifest.webmanifest?v=2" />
    <link rel="icon" href="~/pwa/icon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/pwa/icon-192.png?v=2" />

    <style>
        :root {
            --bg: #0d0b14;
            --sidebar: #13101d;
            --panel: #181424;
            --panel-alt: #120f1c;
            --border: #2d2542;
            --accent: #ff4f8b;
            --accent-secondary: #a855f7;
            --success: #39e58c;
            --warn: #ffb454;
            --danger: #ff7b7b;
            --text: #f5effa;
            --muted: #9d91b0;
            --sidebar-width: 265px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            min-height: 100vh;
            max-width: 100%;
            overflow-x: hidden;
            background: var(--bg);
            color: var(--text);
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        button, input, select, textarea {
            font: inherit;
            max-width: 100%;
        }

        .ig-shell {
            display: flex;
            min-height: 100vh;
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
        }

        .ig-sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            z-index: 1000;
            width: var(--sidebar-width);
            height: 100vh;
            padding: 24px 16px 18px;
            display: flex;
            flex-direction: column;
            background: var(--sidebar);
            border-right: 1px solid var(--border);
            overflow-y: auto;
        }

        .ig-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 8px 20px;
            text-decoration: none;
            border-bottom: 1px solid var(--border);
            margin-bottom: 20px;
        }

        .ig-brand-icon {
            width: 44px;
            height: 44px;
            border-radius: 13px;
            background: linear-gradient(135deg, #06b6d4, #6366f1, #a855f7);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 6px 20px #6366f144;
        }

        .ig-brand-icon svg {
            width: 25px;
            height: 25px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .ig-brand-title {
            margin: 0;
            color: #fff;
            font-size: 17px;
            font-weight: 900;
            letter-spacing: .5px;
        }

        .ig-brand-sub {
            display: block;
            margin-top: 3px;
            color: var(--accent);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.8px;
            text-transform: uppercase;
        }

        .ig-nav-label {
            margin: 0 10px 10px;
            color: var(--muted);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .ig-nav {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .ig-nav-link {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 13px;
            border-radius: 10px;
            color: #c2b6d6;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid transparent;
            transition: all .15s ease;
        }

        .ig-nav-link:hover {
            color: #fff;
            background: #1f1930;
            border-color: #362c52;
        }

        .ig-nav-link.active {
            color: #fff;
            background: linear-gradient(90deg, #ff4f8b26, #a855f71a);
            border-color: #ff4f8b66;
        }

        .ig-nav-link svg {
            width: 19px;
            height: 19px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .ig-user-box {
            margin-top: auto;
            padding: 14px;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .ig-user-name {
            margin: 0;
            font-size: 13px;
            font-weight: 800;
            color: #fff;
        }

        .ig-user-handle {
            margin: 4px 0 0;
            font-size: 11px;
            color: var(--accent);
            font-weight: 700;
        }

        .ig-role-pill {
            display: inline-block;
            margin-top: 6px;
            padding: 3px 7px;
            border-radius: 5px;
            font-size: 9.5px;
            font-weight: 850;
            text-transform: uppercase;
            background: #251c38;
            color: #d7c3f0;
            border: 1px solid #423163;
        }

        .ig-main {
            flex: 1;
            min-width: 0;
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
        }

        .ig-topbar {
            position: sticky;
            top: 0;
            z-index: 900;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            min-height: 64px;
            padding: 12px 30px;
            background: #110e1aee;
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(12px);
        }

        .ig-topbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .ig-menu-toggle {
            display: none;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            background: #1d172b;
            color: #fff;
            border: 1px solid var(--border);
            border-radius: 9px;
            cursor: pointer;
        }

        .ig-menu-toggle svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
        }

        .ig-topbar-title {
            font-size: 13px;
            color: var(--muted);
        }

        .ig-topbar-title strong {
            color: #fff;
        }

        .ig-topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .ig-install-btn {
            padding: 8px 13px;
            background: linear-gradient(90deg, #ff4f8b, #ff7a59);
            color: #16050c;
            border: 0;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 850;
            cursor: pointer;
        }

        .ig-install-btn[hidden] {
            display: none;
        }

        .ig-badge-account {
            padding: 6px 11px;
            border-radius: 8px;
            background: #231934;
            border: 1px solid #442f66;
            color: #f3d4ff;
            font-size: 11px;
            font-weight: 800;
        }

        .ig-logout-btn {
            padding: 8px 13px;
            background: #1c162b;
            color: #f5effa;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .ig-logout-btn:hover {
            border-color: var(--accent);
        }

        .ig-content {
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            padding: 28px 30px 44px;
        }

        .ig-mobile-overlay {
            display: none;
        }

        @@media (max-width: 860px) {
            .ig-sidebar {
                width: min(270px, 84vw);
                transform: translateX(-100%);
                transition: transform .22s ease;
                box-shadow: 15px 0 45px #0008;
            }

            body.ig-menu-open .ig-sidebar {
                transform: translateX(0);
            }

            .ig-main {
                margin-left: 0;
                width: 100%;
                max-width: 100%;
                overflow-x: hidden;
            }

            .ig-menu-toggle {
                display: inline-flex;
                flex-shrink: 0;
            }

            .ig-topbar {
                padding: 10px 12px;
                gap: 8px;
            }

            .ig-topbar-left {
                min-width: 0;
                flex: 1 1 auto;
            }

            .ig-topbar-title {
                font-size: 11.5px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .ig-topbar-right {
                gap: 6px;
                flex-shrink: 0;
            }

            .ig-badge-account {
                max-width: 135px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-size: 10px;
                padding: 5px 8px;
            }

            .ig-content {
                padding: 16px 11px 30px;
                max-width: 100%;
                overflow-x: hidden;
            }

            .ig-mobile-overlay {
                position: fixed;
                inset: 0;
                z-index: 950;
                background: #00000088;
            }

            body.ig-menu-open .ig-mobile-overlay {
                display: block;
            }
        }
    </style>
</head>
<body>
    <div class="ig-shell">
        <aside class="ig-sidebar" id="igSidebar">
            <a href="/" class="ig-brand">
                <span class="ig-brand-icon">
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="4" width="14" height="14" rx="3" />
                        <path d="M3 9h14M7 2v4M13 2v4" />
                        <circle cx="17" cy="17" r="4.5" fill="#13101d" />
                        <path d="M17 14.8V17l1.6 1" />
                    </svg>
                </span>
                <span>
                    <span class="ig-brand-title">AGENDADOR PRO</span>
                    <span class="ig-brand-sub">Social Suite PWA</span>
                </span>
            </a>

            <p class="ig-nav-label">Menu do Aplicativo</p>
            <nav class="ig-nav">
                <a href="/"
                   class="ig-nav-link @(Context.Request.Path == "/" || Context.Request.Path.StartsWithSegments("/Index") ? "active" : "")">
                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="3" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    <span>Agendamentos (Feed & Stories)</span>
                </a>

                @if (ehAdmin)
                {
                    <a href="/Configuracoes"
                       class="ig-nav-link @(Context.Request.Path.StartsWithSegments("/Configuracoes") ? "active" : "")">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="3" />
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.604.852.997 1.51 1H21a2 2 0 1 1 0-4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
                        </svg>
                        <span>Usuários & Perfis IG (Admin)</span>
                    </a>
                }
            </nav>

            <div class="ig-user-box">
                <p class="ig-user-name">@usuarioLogado</p>
                <p class="ig-user-handle">Instagram: @instagramVinculado</p>
                <span class="ig-role-pill">
                    @(ehAdmin ? "Administrador" : "Usuário Vinculado")
                </span>
                @if (ehAdmin)
                {
                    <div style="margin-top:10px;">
                        <a href="/Configuracoes"
                           style="font-size:11px;color:#c8b6e2;text-decoration:underline;">
                            Gerenciar usuários e perfis →
                        </a>
                    </div>
                }
            </div>
        </aside>

        <div class="ig-mobile-overlay" id="igMobileOverlay" aria-hidden="true"></div>

        <div class="ig-main">
            <header class="ig-topbar">
                <div class="ig-topbar-left">
                    <button type="button"
                            class="ig-menu-toggle"
                            id="igMenuToggle"
                            aria-label="Abrir menu">
                        <svg viewBox="0 0 24 24">
                            <path d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                    <div class="ig-topbar-title">
                        IG AGENDADOR PRO / <strong>@ViewData["Title"]</strong>
                    </div>
                </div>
                <div class="ig-topbar-right">
                    <button type="button"
                            class="ig-install-btn"
                            id="igInstallButton"
                            hidden>
                        📲 Instalar App
                    </button>
                    <span class="ig-badge-account">
                        @instagramVinculado
                    </span>
                    <form method="post" asp-page="/Account/Logout" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ig-logout-btn">Sair</button>
                    </form>
                </div>
            </header>

            <main class="ig-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        (() => {
            const toggle = document.getElementById("igMenuToggle");
            const overlay = document.getElementById("igMobileOverlay");

            if (toggle && overlay) {
                const closeMenu = () => document.body.classList.remove("ig-menu-open");
                toggle.addEventListener("click", () => document.body.classList.toggle("ig-menu-open"));
                overlay.addEventListener("click", closeMenu);
            }

            if ("serviceWorker" in navigator && window.isSecureContext) {
                window.addEventListener("load", () => {
                    navigator.serviceWorker.register("/service-worker.js").catch(() => {});
                });
            }

            let installPrompt = null;
            const installButton = document.getElementById("igInstallButton");
            const isStandalone = window.matchMedia("(display-mode: standalone)").matches || window.navigator.standalone === true;

            if (installButton && !isStandalone) {
                window.addEventListener("beforeinstallprompt", event => {
                    event.preventDefault();
                    installPrompt = event;
                    installButton.hidden = false;
                });

                window.addEventListener("appinstalled", () => {
                    installPrompt = null;
                    installButton.hidden = true;
                });

                installButton.addEventListener("click", async () => {
                    if (!installPrompt) return;
                    await installPrompt.prompt();
                    installPrompt = null;
                    installButton.hidden = true;
                });
            }
        })();
    </script>
</body>
</html>
